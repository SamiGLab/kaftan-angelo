---
import Icon from './Icon.astro';
import models from '../data/models.json';

interface Props {
  lang: 'hu' | 'en';
}

const { lang } = Astro.props;
const hu = lang === 'hu';

const visibleModels = models.filter((m) => !m.catalogHidden);

const toThumbAvif = (image: string) =>
  '/assets/images/' + image.replace(/^\//, '').replace(/\.webp$/, '-480.avif');
const toThumbWebp = (image: string) =>
  '/assets/images/' + image.replace(/^\//, '').replace(/\.webp$/, '-480.webp');

const firstByCat = (huUrl: string) =>
  visibleModels.find((m) => m.category.hu.url === huUrl) ?? visibleModels[0];

const womenSample = firstByCat('/noi-borkabatok/');
const menSample = firstByCat('/ferfi-borkabatok/');
const shearlingSample = firstByCat('/irhakabatok/');
const furSample = firstByCat('/szormekabatok/');
const secondWomenSample =
  visibleModels.filter((m) => m.category.hu.url === '/noi-borkabatok/')[1] ?? womenSample;
const thirdWomenSample =
  visibleModels.filter((m) => m.category.hu.url === '/noi-borkabatok/')[2] ?? womenSample;

const stories = [
  {
    href: hu ? '/noi-borkabatok/' : '/en/womens-leather-jackets/',
    label: hu ? 'Női bőrkabátok' : 'Women’s leather',
    img: womenSample.image,
  },
  {
    href: hu ? '/ferfi-borkabatok/' : '/en/mens-leather-jackets/',
    label: hu ? 'Férfi bőrkabátok' : 'Men’s leather',
    img: menSample.image,
  },
  {
    href: hu ? '/irhakabatok/' : '/en/shearling-jackets/',
    label: hu ? 'Irhakabátok' : 'Shearling coats',
    img: shearlingSample.image,
  },
  {
    href: hu ? '/szormekabatok/' : '/en/fur-coats/',
    label: hu ? 'Szőrmekabátok' : 'Fur coats',
    img: furSample.image,
  },
  {
    href: hu ? '/egyedi-rendeles/' : '/en/custom-orders/',
    label: hu ? 'Egyedi rendelés' : 'Custom orders',
    img: secondWomenSample.image,
  },
  {
    href: hu ? '/kollekciok/' : '/en/collections/',
    label: hu ? `Összes modell (${visibleModels.length})` : `All models (${visibleModels.length})`,
    img: thirdWomenSample.image,
  },
];

const services = hu
  ? [
      { icon: 'store' as const, title: 'Belvárosi üzlet', sub: 'Kossuth Lajos u. 18 · 2004 óta' },
      { icon: 'clock' as const, title: 'Személyes próba', sub: 'Időpontfoglalás nélkül is' },
      { icon: 'scissors' as const, title: 'Méretre igazítás', sub: 'Ujjhossz és derék igazítása' },
      { icon: 'shield' as const, title: 'Valódi bőr és irha', sub: 'Ellenőrzött, természetes anyagok' },
    ]
  : [
      { icon: 'store' as const, title: 'Central Budapest store', sub: 'Kossuth Lajos u. 18 · Since 2004' },
      { icon: 'clock' as const, title: 'Personal fitting', sub: 'Walk-ins welcome, no booking needed' },
      { icon: 'scissors' as const, title: 'Tailored sizing', sub: 'Sleeve & waist adjustments in-store' },
      { icon: 'shield' as const, title: 'Genuine leather & fur', sub: 'Verified natural materials' },
    ];
---

<section class="home-discovery" aria-label={hu ? 'Gyors kategória- és szolgáltatás áttekintés' : 'Quick category and service overview'}>
  <div class="wrap">
    <ul class="story-strip">
      {stories.map((item) => (
        <li>
          <a href={item.href} class="story-card">
            <span class="story-thumb">
              <picture>
                <source srcset={toThumbAvif(item.img)} type="image/avif" />
                <source srcset={toThumbWebp(item.img)} type="image/webp" />
                <img src={item.img} alt={item.label} width="96" height="96" loading="lazy" decoding="async" />
              </picture>
            </span>
            <span class="story-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <ul class="service-strip" aria-label={hu ? 'Üzleti előnyök' : 'Boutique services'}>
      {services.map((s) => (
        <li class="service-item">
          <span class="service-icon" aria-hidden="true"><Icon name={s.icon} /></span>
          <span class="service-copy">
            <strong>{s.title}</strong>
            <span>{s.sub}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-discovery {
    padding: 2rem 0 1.5rem;
    border-bottom: 1px solid var(--line, #efe4d229);
  }
  .story-strip {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }
  .story-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    color: var(--cream, #efe4d2);
    text-decoration: none;
  }
  .story-thumb {
    width: 92px;
    height: 92px;
    border-radius: 999px;
    overflow: hidden;
    border: 2px solid #dcb27c55;
    background: var(--product-surface, #e8e5df);
    display: block;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .story-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .story-card:hover .story-thumb,
  .story-card:focus-visible .story-thumb {
    transform: translateY(-3px);
    border-color: var(--bright, #dcb27c);
  }
  .story-label {
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .service-strip {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0.25rem;
    border-top: 1px solid var(--line, #efe4d229);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .service-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .service-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #dcb27c14;
    border: 1px solid #dcb27c3d;
    color: var(--bright, #dcb27c);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .service-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .service-copy strong {
    font-size: 0.9rem;
    color: var(--cream, #efe4d2);
    line-height: 1.25;
  }
  .service-copy span {
    font-size: 0.78rem;
    color: var(--dim, #c9bba5);
    line-height: 1.35;
  }

  @media (max-width: 980px) {
    .story-strip {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.85rem;
      padding-bottom: 0.35rem;
    }
    .story-strip > li {
      flex: 0 0 92px;
      scroll-snap-align: start;
    }
    .story-thumb {
      width: 78px;
      height: 78px;
    }
    .service-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .home-discovery {
      padding: 1.5rem 0 1.25rem;
    }
    .service-strip {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
