---
import Icon from './Icon.astro';
import Newsletter from './Newsletter.astro';
const { lang = 'hu', trackingAllowed=true } = Astro.props;
const hu = lang === 'hu';
const links = hu ? [['Kollekciók','/kollekciok/'],['Egyedi rendelés','/egyedi-rendeles/'],['Rólunk','/rolunk/'],['Üzlet','/uzlet/'],['GYIK','/gyik/'],['Partnerprogram','/partnerprogram/'],['Útmutatók','/utmutatok/']] : [['Collections','/en/collections/'],['Custom orders','/en/custom-orders/'],['About us','/en/about/'],['Visit us','/en/visit/'],['FAQ','/en/faq/'],['Partners','/en/partners/'],['Guides','/en/guides/']];
---
{trackingAllowed && <Newsletter lang={lang} />}
<footer class="footer"><div class="wrap footer-grid">
  <div class="footer-store"><a class="brand" href={hu ? '/' : '/en/'}>Kaftan <span>Angelo</span></a><p>{hu ? 'Bőr, irha, szőrme és kiegészítők.' : 'Leather, shearling, fur and accessories.'}</p><p>{hu ? 'Budapesti üzletünk 2004 óta.' : 'Our Budapest store, since 2004.'}</p><a class="footer-address" href={hu ? '/uzlet/' : '/en/visit/'}><Icon name="location" /><span>Kossuth Lajos u. 18<br />1053 Budapest</span></a></div>
  <div><h2>{hu ? 'Fedezze fel' : 'Explore'}</h2><nav class="footer-links" aria-label={hu ? 'Lábléc navigáció' : 'Footer navigation'}>{links.map(([label,href]) => <a href={href}>{label}</a>)}</nav></div>
  <div><h2>{hu ? 'Lépjen kapcsolatba' : 'Get in touch'}</h2><div class="footer-contact"><a href="mailto:alfinafashionkft@gmail.com"><Icon name="mail" /><span>alfinafashionkft@gmail.com</span></a><a href="tel:+3612667274"><Icon name="phone" />+36&nbsp;1&nbsp;266&nbsp;7274</a><a href="https://wa.me/36203593216">WhatsApp · +36 20 359 3216 <span aria-hidden="true">↗</span></a></div><nav class="footer-social" aria-label={hu ? 'Közösségi média' : 'Social media'}><a href="https://www.instagram.com/kaftanangelo.budapest/">Instagram <span aria-hidden="true">↗</span></a><a href="https://www.facebook.com/KaftanAngelo2004">Facebook <span aria-hidden="true">↗</span></a><a href="https://www.tiktok.com/@kaftanangelo.budapest">TikTok <span aria-hidden="true">↗</span></a></nav></div>
  <div class="footer-hours"><h2>{hu ? 'Nyitvatartás' : 'Opening hours'}</h2><div class="footer-hours-row"><span>{hu ? 'Hétfő–Péntek' : 'Monday–Friday'}</span><strong>10:00–19:00</strong></div><div class="footer-hours-row"><span>{hu ? 'Szombat' : 'Saturday'}</span><strong>10:00–17:00</strong></div><a class="footer-visit" href={hu ? '/uzlet/' : '/en/visit/'}><Icon name="route" />{hu ? 'Üzlet és útvonal' : 'Store and directions'} <span aria-hidden="true">↗</span></a></div>
</div><div class="wrap footer-bottom"><span class="footer-copyright">© <span class="current-year"></span> Kaftan Angelo</span><nav class="footer-legal" aria-label={hu ? 'Jogi információk' : 'Legal information'}><a href={hu ? '/sutikezeles/' : '/en/cookies/'}>{hu ? 'Sütik és külső szolgáltatások' : 'Cookies and external services'}</a><a href={hu ? '/uzemelteto/' : '/en/site-information/'}>{hu ? 'Üzemeltető és weboldalhasználat' : 'Operator and website use'}</a>{trackingAllowed && <button type="button" class="consent-settings" data-consent-open>{hu ? 'Sütibeállítások' : 'Cookie settings'}</button>}</nav></div></footer>
