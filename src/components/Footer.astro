---
import Icon from './Icon.astro';
const { lang = 'hu', trackingAllowed=true } = Astro.props;
const hu = lang === 'hu';
const links = hu ? [['Kollekciók','/kollekciok/'],['Egyedi rendelés','/egyedi-rendeles/'],['Rólunk','/rolunk/'],['Üzlet','/uzlet/'],['GYIK','/gyik/'],['Partnerprogram','/partnerprogram/'],['Útmutatók','/utmutatok/']] : [['Collections','/en/collections/'],['Custom orders','/en/custom-orders/'],['About us','/en/about/'],['Visit us','/en/visit/'],['FAQ','/en/faq/'],['Partners','/en/partners/'],['Guides','/en/guides/']];
---
<footer class="footer"><div class="wrap footer-grid">
  <div><a class="brand" href={hu ? '/' : '/en/'}>Kaftan <span>Angelo</span></a><p>{hu ? 'Bőr, irha, szőrme és kiegészítők.' : 'Leather, shearling, fur and accessories.'}</p><p>{hu ? 'Budapesti üzletünk 2004 óta.' : 'Our Budapest store, since 2004.'}<br />Kossuth Lajos u. 18, Budapest 1053</p></div>
  <div><h2>{hu ? 'Fedezze fel' : 'Explore'}</h2><nav class="footer-links" aria-label={hu ? 'Lábléc navigáció' : 'Footer navigation'}>{links.map(([label,href]) => <a href={href}>{label}</a>)}<a href={hu ? '/sutikezeles/' : '/en/cookies/'}>{hu ? 'Sütik és külső szolgáltatások' : 'Cookies and external services'}</a><a href={hu ? '/uzemelteto/' : '/en/site-information/'}>{hu ? 'Üzemeltető és weboldalhasználat' : 'Operator and website use'}</a></nav></div>
  <div><h2>{hu ? 'Lépjen kapcsolatba' : 'Get in touch'}</h2><div class="footer-contact"><a href="mailto:alfinafashionkft@gmail.com"><Icon name="mail" />alfinafashionkft@gmail.com</a><a href="tel:+3612667274"><Icon name="phone" />+36&nbsp;1&nbsp;266&nbsp;7274</a><a href="https://wa.me/36203593216">WhatsApp · +36 20 359 3216</a><a href="https://www.instagram.com/kaftanangelo.budapest/">Instagram ↗</a><a href="https://www.facebook.com/KaftanAngelo2004">Facebook ↗</a><a href="https://www.tiktok.com/@kaftanangelo.budapest">TikTok ↗</a></div><p><Icon name="clock" />{hu ? 'Hétfő–Péntek' : 'Monday–Friday'} · 10:00–19:00<br />{hu ? 'Szombat' : 'Saturday'} · 10:00–17:00</p></div>
</div><div class="wrap footer-bottom">{trackingAllowed && <button type="button" class="consent-settings" data-consent-open>{hu ? 'Sütibeállítások' : 'Cookie settings'}</button>} © <span class="current-year"></span> Kaftan Angelo</div></footer>
