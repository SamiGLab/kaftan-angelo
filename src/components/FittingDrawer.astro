---
import Icon from './Icon.astro';

interface Props {
  lang?: 'hu' | 'en';
}

const { lang = 'hu' } = Astro.props;
const hu = lang === 'hu';
const searchDataUrl = `/assets/data/home-search-${lang}.json`;
const catalogUrl = hu ? '/kollekciok/' : '/en/collections/';
const visitUrl = hu ? '/uzlet/' : '/en/visit/';
---

<dialog
  class="fitting-drawer-dialog"
  data-fitting-drawer
  aria-labelledby="fitting-drawer-title"
>
  <div class="fd-shell">
    <div class="fd-head">
      <div class="fd-title-wrap">
        <h2 id="fitting-drawer-title">{hu ? 'Próbalistám' : 'My fitting list'}</h2>
        <span class="fd-count" data-fd-count>0</span>
      </div>
      <button
        type="button"
        class="fd-close"
        data-fd-close
        aria-label={hu ? 'Próbalista bezárása' : 'Close fitting list'}
      >
        <Icon name="x" />
      </button>
    </div>

    <div class="fd-body" data-fd-body aria-live="polite">
      <p class="fd-loading">{hu ? 'Betöltés…' : 'Loading…'}</p>
    </div>

    <div class="fd-foot" data-fd-foot hidden>
      <label class="fd-group-opt">
        <input type="checkbox" data-fd-team-group />
        <span>
          <strong>{hu ? 'Privát WhatsApp-csoport kérése a listához' : 'Request a private WhatsApp group for this list'}</strong>
          <small>{hu ? 'A fő üzleti számunkkal indul az 1-1 chat; kérésre csapatunk manuálisan nyitja meg az Ön privát csoportját.' : 'Starts a 1-on-1 chat with our main store WhatsApp; on request, our team manually creates your private group.'}</small>
        </span>
      </label>
      <a
        class="btn btn-primary fd-wa-btn"
        data-fd-whatsapp
        href="https://wa.me/36203593216"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="message" />
        <span>{hu ? 'Lista küldése WhatsAppon' : 'Send list on WhatsApp'}</span>
      </a>
      <div class="fd-foot-secondary">
        <a class="fd-visit-link" href={visitUrl}>
          <Icon name="location" />
          <span>{hu ? 'Üzlet & útvonal' : 'Store & directions'}</span>
        </a>
        <button type="button" class="fd-clear-btn" data-fd-clear>
          {hu ? 'Lista ürítése' : 'Clear list'}
        </button>
      </div>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ searchDataUrl, catalogUrl, lang }}>
(() => {
  const dialog = document.querySelector('[data-fitting-drawer]');
  if (!dialog) return;
  const bodyEl = dialog.querySelector('[data-fd-body]');
  const footEl = dialog.querySelector('[data-fd-foot]');
  const countEl = dialog.querySelector('[data-fd-count]');
  const waLink = dialog.querySelector('[data-fd-whatsapp]');
  const closeBtn = dialog.querySelector('[data-fd-close]');
  const clearBtn = dialog.querySelector('[data-fd-clear]');
  const groupCheck = dialog.querySelector('[data-fd-team-group]');
  if (!bodyEl || !footEl || !countEl || !waLink) return;

  const hu = lang === 'hu';
  const STORAGE_KEY = 'kaftan_fitting_list_v1';
  const LIMIT = 12;
  let indexPromise = null;
  let lastTrigger = null;

  const loadIndex = () => {
    if (!indexPromise) {
      indexPromise = fetch(searchDataUrl).then((r) => (r.ok ? r.json() : [])).catch(() => []);
    }
    return indexPromise;
  };

  const readSlugs = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      return Array.isArray(parsed) ? parsed.slice(0, LIMIT) : [];
    } catch {
      return [];
    }
  };

  const writeSlugs = (slugs) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(slugs.slice(0, LIMIT)));
    } catch {}
    window.dispatchEvent(new Event('kaftan-fitting-change'));
  };

  const esc = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const render = async () => {
    const slugs = readSlugs();
    countEl.textContent = String(slugs.length);
    if (!slugs.length) {
      footEl.hidden = true;
      bodyEl.innerHTML = `<div class="fd-empty">
        <p class="fd-empty-title">${hu ? 'A próbalistája jelenleg üres.' : 'Your fitting list is currently empty.'}</p>
        <p class="fd-empty-copy">${
          hu
            ? 'Mentse el a kiszemelt modelleket a szív (♡) ikonnal, majd küldje el őket egyszerre WhatsAppon vagy mutassa meg budapesti üzletünkben.'
            : 'Save models you would like to try on using the heart (♡) icon, then share them on WhatsApp or show them at our Budapest store.'
        }</p>
        <a class="btn btn-primary fd-browse-btn" href="${catalogUrl}">${hu ? 'Kollekció böngészése' : 'Browse collections'}</a>
      </div>`;
      return;
    }

    const catalog = await loadIndex();
    const bySlug = new Map(catalog.map((item) => [item.s, item]));
    const matched = slugs.map((slug) => bySlug.get(slug)).filter(Boolean);

    if (!matched.length) {
      footEl.hidden = true;
      bodyEl.innerHTML = `<div class="fd-empty">
        <p class="fd-empty-title">${hu ? 'A mentett modellek betöltése nem sikerült.' : 'Could not load saved models.'}</p>
        <a class="btn btn-primary fd-browse-btn" href="${catalogUrl}">${hu ? 'Kollekció böngészése' : 'Browse collections'}</a>
      </div>`;
      return;
    }

    bodyEl.innerHTML = `<ul class="fd-list">${matched
      .map(
        (m) => `<li class="fd-item">
          <a class="fd-item-link" href="${esc(m.u)}">
            <img src="${esc(m.i)}" alt="" width="56" height="70" loading="lazy" decoding="async" />
            <span class="fd-item-meta">
              <strong>${esc(m.n)}</strong>
              <span>${esc(m.c)}${m.m ? ' · ' + esc(m.m) : ''}</span>
            </span>
          </a>
          <button
            type="button"
            class="fd-remove"
            data-fd-remove="${esc(m.s)}"
            aria-label="${esc(hu ? `${m.n} eltávolítása a próbalistáról` : `Remove ${m.n} from fitting list`)}"
          >×</button>
        </li>`
      )
      .join('')}</ul>`;

    const lines = matched.map((m, idx) => `${idx + 1}. ${m.n} — https://kaftanangelo.com${m.u}`);
    const intro = hu
      ? 'Üdvözlöm! A Kaftan Angelo próbalistámról az alábbi modellek ára és mérete felől érdeklődnék:'
      : 'Hello! I would like to ask about prices, sizes and availability for these models from my Kaftan Angelo fitting list:';
    const groupLine = groupCheck?.checked
      ? (hu
          ? '\n\nKérés: szeretnék külön privát WhatsApp-csoportot az üzlet csapatával az egyeztetéshez.'
          : '\n\nRequest: please open a separate private WhatsApp group with your store team for my consultation.')
      : '';
    waLink.href = `https://wa.me/36203593216?text=${encodeURIComponent(`${intro}\n${lines.join('\n')}${groupLine}`)}`;
    footEl.hidden = false;
  };

  const openDrawer = (trigger) => {
    lastTrigger = trigger instanceof HTMLElement ? trigger : document.activeElement;
    window.dispatchEvent(new CustomEvent('kaftan-close-overlays', { detail: { except: 'fitting' } }));
    render();
    if (!dialog.open) dialog.showModal();
    requestAnimationFrame(() => closeBtn?.focus());
  };

  const closeDrawer = (restoreFocus = true) => {
    if (dialog.open) dialog.close();
    if (restoreFocus && lastTrigger instanceof HTMLElement) {
      lastTrigger.focus();
    }
  };

  document.addEventListener('click', (e) => {
    const trigger =
      e.target instanceof Element
        ? e.target.closest('.header-fitting-btn, [data-mobile-fitting-link], [data-open-fitting-drawer]')
        : null;
    if (trigger) {
      e.preventDefault();
      openDrawer(trigger);
    }
  });

  bodyEl.addEventListener('click', (e) => {
    const removeBtn = e.target instanceof Element ? e.target.closest('[data-fd-remove]') : null;
    if (!removeBtn) return;
    const slug = removeBtn.getAttribute('data-fd-remove');
    if (!slug) return;
    writeSlugs(readSlugs().filter((s) => s !== slug));
    render();
  });

  clearBtn?.addEventListener('click', () => {
    writeSlugs([]);
    render();
  });
  groupCheck?.addEventListener('change', () => render());

  closeBtn?.addEventListener('click', () => closeDrawer(true));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) closeDrawer(true);
  });
  dialog.addEventListener('cancel', () => {
    if (lastTrigger instanceof HTMLElement) {
      requestAnimationFrame(() => lastTrigger.focus());
    }
  });

  window.addEventListener('kaftan-fitting-change', () => {
    if (dialog.open) render();
  });
  window.addEventListener('storage', () => {
    if (dialog.open) render();
  });
  window.addEventListener('kaftan-close-overlays', (e) => {
    if (e.detail?.except !== 'fitting' && dialog.open) closeDrawer(false);
  });
})();
</script>

<style>
  .fitting-drawer-dialog {
    margin: 0 0 0 auto;
    padding: 0;
    width: min(380px, 90vw);
    max-width: 90vw;
    height: 100dvh;
    max-height: 100dvh;
    border: 0;
    border-left: 1px solid #e6eaf0;
    border-radius: 0;
    background: #ffffff;
    color: #1d2128;
    box-shadow: -12px 0 36px rgba(29, 33, 40, 0.18);
    overflow: hidden;
  }
  .fitting-drawer-dialog::backdrop {
    background: rgba(29, 33, 40, 0.48);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .fitting-drawer-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: fdSlideIn 0.2s ease-out;
  }
  @keyframes fdSlideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fitting-drawer-dialog[open] { animation: none; }
  }

  .fd-shell {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    min-width: 0;
  }
  .fd-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px 12px 18px;
    border-bottom: 1px solid #ecf0f4;
    flex: 0 0 auto;
  }
  .fd-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .fd-head h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: #1d2128;
  }
  .fd-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 7px;
    border-radius: 999px;
    background: #1d2128;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .fd-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid #e6eaf0;
    background: #f6f7f9;
    color: #1d2128;
    cursor: pointer;
    flex: 0 0 auto;
  }
  .fd-close:hover { background: #eef1f5; border-color: #1d2128; }
  .fd-close :global(.ui-icon) { width: 20px; height: 20px; margin: 0; }

  .fd-body {
    flex: 1 1 auto;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 14px 16px;
    overscroll-behavior: contain;
  }
  .fd-loading { color: #5d636e; font-size: 0.9rem; margin: 12px 0; }
  .fd-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px 6px;
  }
  .fd-empty-title { margin: 0; font-size: 0.98rem; font-weight: 600; color: #1d2128; }
  .fd-empty-copy { margin: 0; font-size: 0.86rem; line-height: 1.55; color: #5d636e; }
  .fd-browse-btn { margin-top: 6px; min-height: 44px; background: #1d2128; border-color: #1d2128; color: #ffffff; }

  .fd-body :global(.fd-list) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fd-body :global(.fd-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border: 1px solid #ecf0f4;
    border-radius: 8px;
    background: #ffffff;
  }
  .fd-body :global(.fd-item:hover) { border-color: #d5dce4; }
  .fd-body :global(.fd-item-link) {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  .fd-body :global(.fd-item-link img) {
    width: 56px;
    height: 70px;
    object-fit: cover;
    object-position: center top;
    border-radius: 6px;
    background: #f4f3f0;
    flex: 0 0 auto;
  }
  .fd-body :global(.fd-item-meta) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .fd-body :global(.fd-item-meta strong) {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
    color: #1d2128;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fd-body :global(.fd-item-meta span) {
    font-size: 0.76rem;
    color: #5d636e;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fd-body :global(.fd-remove) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid #e6eaf0;
    background: #f6f7f9;
    color: #5d636e;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    flex: 0 0 auto;
  }
  .fd-body :global(.fd-remove:hover) { border-color: #1d2128; color: #1d2128; background: #eef1f5; }

  .fd-foot {
    flex: 0 0 auto;
    padding: 14px 16px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid #ecf0f4;
    background: #f6f7f9;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fd-foot[hidden] { display: none !important; }
  .fd-group-opt {
    display: flex; align-items: flex-start; gap: 9px; padding: 9px 10px;
    border: 1px solid #e2e6ec; border-radius: 8px; background: #ffffff; cursor: pointer;
  }
  .fd-group-opt input { flex: 0 0 18px; width: 18px; height: 18px; margin: 2px 0 0; accent-color: #1d2128; }
  .fd-group-opt span { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .fd-group-opt strong { font-size: 0.8rem; font-weight: 600; color: #1d2128; line-height: 1.3; }
  .fd-group-opt small { font-size: 0.72rem; color: #5d636e; line-height: 1.38; }
  .fd-wa-btn {
    width: 100%;
    min-height: 46px;
    justify-content: center;
    background: #1d2128;
    border-color: #1d2128;
    color: #ffffff;
  }
  .fd-wa-btn:hover { background: #2d3440; border-color: #2d3440; color: #ffffff; }
  .fd-foot-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .fd-visit-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    color: #1d2128;
    text-decoration: none;
    min-height: 36px;
  }
  .fd-visit-link:hover { color: #9c522b; text-decoration: underline; }
  .fd-visit-link :global(.ui-icon) { width: 15px; height: 15px; color: #9c522b; margin: 0; }
  .fd-clear-btn {
    background: transparent;
    border: 0;
    padding: 6px 4px;
    min-height: 36px;
    font-size: 0.8rem;
    color: #5d636e;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    font-family: inherit;
  }
  .fd-clear-btn:hover { color: #1d2128; }
</style>
