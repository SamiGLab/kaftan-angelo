---
const {
  lang = 'hu',
  pageTitle = 'Kaftan Angelo Budapest',
  canonicalUrl = 'https://kaftanangelo.com/',
} = Astro.props;

const hu = lang === 'hu';
const phone = '36203593216';

const initialMessage = hu
  ? `Üdvözlöm! A(z) "${pageTitle}" kapcsán érdeklődnék a budapesti üzletükben elérhető méretekről és modellekről: ${canonicalUrl}`
  : `Hello! I would like to inquire about "${pageTitle}" and check available models and sizes at your Budapest showroom: ${canonicalUrl}`;

const quickChips = hu
  ? [
      { label: '📸 Fotó & videó kérése', text: `Üdvözlöm! Tudnának küldeni részletes fotót vagy videót erről a modellről felvéve? (${pageTitle})` },
      { label: '🏷️ Árak & kedvezmények', text: `Üdvözlöm! Érdeklődnék a(z) "${pageTitle}" aktuális áráról és az elérhető kedvezményekről.` },
      { label: '✈️ Szállítás & hotel delivery', text: 'Üdvözlöm! Érdeklődnék a budapesti szállodai kiszállításról, illetve a nemzetközi postázásról.' },
      { label: '🧥 Méretek & elérhetőség', text: `Üdvözlöm! A(z) "${pageTitle}" kapcsán érdeklődnék, hogy milyen méretek érhetők el most készleten?` }
    ]
  : [
      { label: '📸 Live photo & video', text: `Hello! Could you please share detailed live photos or a short video of this model? (${pageTitle})` },
      { label: '🏷️ Prices & offers', text: `Hello! Could you share the price and any boutique offers for "${pageTitle}"?` },
      { label: '✈️ Hotel & global shipping', text: 'Hello! Do you deliver directly to hotels in Budapest or offer international shipping?' },
      { label: '🧥 Size & stock availability', text: `Hello! I would like to check available sizes and in-stock models for "${pageTitle}".` }
    ];
---

<div class="whatsapp-quick-chat">
  <!-- Chat Popup Card -->
  <div class="chat-card" id="whatsapp-chat-card" role="dialog" aria-labelledby="chat-card-title" hidden>
    <div class="chat-header">
      <div class="chat-avatar-wrap">
        <div class="chat-avatar" aria-hidden="true">KA</div>
        <span class="chat-status-dot"></span>
      </div>
      <div class="chat-header-info">
        <h3 id="chat-card-title" class="chat-title">Kaftan Angelo</h3>
        <p class="chat-status">{hu ? 'Budapest · Általában perceken belül válaszolunk' : 'Budapest · Typically replies in minutes'}</p>
      </div>
      <button type="button" class="chat-close-btn" id="whatsapp-close-btn" aria-label={hu ? 'Ablak bezárása' : 'Close chat window'}>×</button>
    </div>

    <div class="chat-body">
      <div class="chat-message-bubble">
        <p class="chat-bubble-text">
          {hu
            ? 'Üdvözöljük a Kaftan Angelónál! Miben segíthetünk? Érdeklődjön méretekről, aktuális készletünkről vagy egyedi rendelésről.'
            : 'Welcome to Kaftan Angelo! How may we assist you? Inquire about sizes, showroom stock, or custom orders.'}
        </p>
        <span class="chat-bubble-time">{hu ? 'Most' : 'Just now'}</span>
      </div>

      <div class="chat-quick-chips">
        <p class="chat-chips-label">{hu ? 'Gyors témák:' : 'Quick topics:'}</p>
        <div class="chat-chips-list">
          {quickChips.map((chip) => (
            <button
              type="button"
              class="chat-chip-btn"
              data-chip-text={chip.text + "\n" + canonicalUrl}
            >
              {chip.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="chat-footer">
      <div class="chat-input-wrap">
        <textarea
          id="whatsapp-chat-input"
          class="chat-input"
          rows="2"
          aria-label={hu ? 'Az Ön üzenete' : 'Your message'}
        >{initialMessage}</textarea>
        <button
          type="button"
          id="whatsapp-send-btn"
          class="chat-send-btn"
          aria-label={hu ? 'Üzenet küldése WhatsAppon' : 'Send message via WhatsApp'}
        >
          <span class="send-btn-text">{hu ? 'Beszélgetés indítása' : 'Start Chat'}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
          </svg>
        </button>
      </div>
      <p class="chat-footer-note">{hu ? 'Kossuth Lajos u. 18 · +36 20 359 3216' : 'Kossuth Lajos u. 18 · +36 20 359 3216'}</p>
    </div>
  </div>

  <!-- Floating Trigger Button -->
  <button
    type="button"
    class="whatsapp-float-trigger"
    id="whatsapp-trigger-btn"
    aria-expanded="false"
    aria-controls="whatsapp-chat-card"
    aria-label={hu ? 'WhatsApp gyors beszélgetés megnyitása' : 'Open WhatsApp quick chat'}
  >
    <span class="trigger-online-badge" aria-hidden="true"></span>
    <span class="trigger-label">{hu ? 'Gyors beszélgetés' : 'Quick Chat'}</span>
    <svg class="whatsapp-icon" viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M16.02 2C8.28 2 2 8.28 2 16.02c0 2.65.73 5.13 2 7.25L2.3 29.7l6.63-1.66c2.03 1.15 4.38 1.8 6.91 1.8 7.74 0 14.02-6.28 14.02-14.02C29.86 8.28 23.58 2 16.02 2zm8.17 19.8c-.35.97-1.74 1.79-2.82 2.03-.74.16-1.71.29-4.96-1.06-4.16-1.72-6.84-5.96-7.05-6.24-.2-.28-1.7-2.27-1.7-4.32s1.08-3.07 1.46-3.48c.38-.41.83-.52 1.11-.52.28 0 .56 0 .8.01.26.02.6-.1.94.72.35.84 1.2 2.92 1.3 3.13.1.21.17.46.03.74-.14.28-.21.45-.42.7-.21.24-.44.54-.63.72-.21.21-.43.44-.19.86.25.41 1.1 1.81 2.36 2.93 1.62 1.44 2.99 1.89 3.42 2.1.42.21.67.18.92-.11.25-.28 1.08-1.25 1.37-1.68.29-.42.58-.35.97-.21.39.14 2.47 1.16 2.89 1.37.42.21.7.31.8.49.1.17.1 1.01-.25 1.98z"/>
    </svg>
  </button>
</div>

<style>
  .whatsapp-quick-chat {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 95;
    font-family: inherit;
  }

  /* Trigger Button */
  .whatsapp-float-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.1rem 0.65rem 0.9rem;
    border-radius: 9999px;
    background: #1b120c;
    color: #efe4d2;
    border: 1.5px solid rgba(196, 157, 100, 0.6);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4), 0 0 12px rgba(196, 157, 100, 0.2);
    cursor: pointer;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .whatsapp-float-trigger:hover {
    transform: translateY(-2px) scale(1.02);
    border-color: #dcb27c;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), 0 0 16px rgba(220, 178, 124, 0.35);
  }

  .whatsapp-float-trigger:focus-visible {
    outline: 3px solid #dcb27c;
    outline-offset: 3px;
  }

  .trigger-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: #f7ede2;
  }

  .whatsapp-icon {
    fill: #25d366;
    flex-shrink: 0;
  }

  .trigger-online-badge {
    position: absolute;
    top: 0.45rem;
    left: 0.75rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 0 2px #1b120c;
    animation: pulse-online 2s infinite;
  }

  @keyframes pulse-online {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(37, 211, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }

  /* Chat Box Card */
  .chat-card {
    position: absolute;
    bottom: calc(100% + 1rem);
    right: 0;
    width: 360px;
    max-width: calc(100vw - 2rem);
    border-radius: 14px;
    background: #241a12;
    border: 1px solid rgba(196, 157, 100, 0.4);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55), 0 0 20px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: chat-appear 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chat-card[hidden] {
    display: none;
  }

  @keyframes chat-appear {
    from { opacity: 0; transform: translateY(12px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* Header */
  .chat-header {
    background: #1b120c;
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(196, 157, 100, 0.25);
  }

  .chat-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .chat-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #2c2016;
    color: #dcb27c;
    border: 1.5px solid #dcb27c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.05em;
  }

  .chat-status-dot {
    position: absolute;
    bottom: 1px;
    right: 1px;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #25d366;
    border: 1.5px solid #1b120c;
  }

  .chat-header-info {
    flex: 1;
    min-width: 0;
  }

  .chat-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: #efe4d2;
    line-height: 1.2;
  }

  .chat-status {
    margin: 0.15rem 0 0 0;
    font-size: 0.75rem;
    color: #c9bba5;
    line-height: 1.2;
  }

  .chat-close-btn {
    background: transparent;
    border: none;
    color: #c9bba5;
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
  }

  .chat-close-btn:hover {
    color: #efe4d2;
  }

  /* Body */
  .chat-body {
    padding: 1rem;
    background: radial-gradient(circle at 50% 0, #2c2016 0%, #20150e 100%);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .chat-message-bubble {
    background: #2c2016;
    border: 1px solid rgba(196, 157, 100, 0.25);
    border-radius: 12px 12px 12px 2px;
    padding: 0.75rem 0.85rem;
    position: relative;
    max-width: 90%;
  }

  .chat-bubble-text {
    margin: 0;
    font-size: 0.825rem;
    line-height: 1.45;
    color: #efe4d2;
  }

  .chat-bubble-time {
    display: block;
    text-align: right;
    font-size: 0.68rem;
    color: #c9bba5;
    margin-top: 0.35rem;
  }

  /* Quick Chips */
  .chat-quick-chips {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .chat-chips-label {
    margin: 0;
    font-size: 0.72rem;
    color: #c9bba5;
    font-weight: 600;
  }

  .chat-chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chat-chip-btn {
    background: #1b120c;
    border: 1px solid rgba(196, 157, 100, 0.35);
    color: #efe4d2;
    padding: 0.3rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.725rem;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    text-align: left;
  }

  .chat-chip-btn:hover {
    background: #2c2016;
    border-color: #dcb27c;
    color: #ffffff;
  }

  /* Footer */
  .chat-footer {
    background: #1b120c;
    padding: 0.85rem 1rem;
    border-top: 1px solid rgba(196, 157, 100, 0.2);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chat-input-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chat-input {
    width: 100%;
    background: #241a12;
    border: 1px solid rgba(196, 157, 100, 0.4);
    border-radius: 8px;
    color: #efe4d2;
    font-family: inherit;
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.55rem 0.7rem;
    resize: none;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .chat-input:focus {
    border-color: #dcb27c;
  }

  .chat-send-btn {
    background: #25d366;
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .chat-send-btn:hover {
    background: #20bd5a;
    transform: translateY(-1px);
  }

  .chat-footer-note {
    margin: 0;
    text-align: center;
    font-size: 0.7rem;
    color: #c9bba5;
  }

  @media (max-width: 480px) {
    .whatsapp-quick-chat {
      bottom: 1rem;
      right: 1rem;
    }
    .trigger-label {
      display: none;
    }
    .whatsapp-float-trigger {
      padding: 0.65rem;
      border-radius: 50%;
    }
    .trigger-online-badge {
      top: 0.25rem;
      left: 0.25rem;
    }
    .chat-card {
      right: 0;
      width: calc(100vw - 2rem);
    }
  }
</style>

<script is:inline define:vars={{ phone }}>
  (function() {
    var triggerBtn = document.getElementById('whatsapp-trigger-btn');
    var chatCard = document.getElementById('whatsapp-chat-card');
    var closeBtn = document.getElementById('whatsapp-close-btn');
    var sendBtn = document.getElementById('whatsapp-send-btn');
    var inputEl = document.getElementById('whatsapp-chat-input');
    var chipBtns = document.querySelectorAll('.chat-chip-btn');

    if (!triggerBtn || !chatCard) return;

    function openChat() {
      chatCard.removeAttribute('hidden');
      triggerBtn.setAttribute('aria-expanded', 'true');
      if (inputEl) {
        inputEl.focus();
      }
    }

    function closeChat() {
      chatCard.setAttribute('hidden', '');
      triggerBtn.setAttribute('aria-expanded', 'false');
    }

    triggerBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isHidden = chatCard.hasAttribute('hidden');
      if (isHidden) {
        openChat();
      } else {
        closeChat();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        closeChat();
      });
    }

    chipBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var text = btn.getAttribute('data-chip-text');
        if (text && inputEl) {
          inputEl.value = text;
          inputEl.focus();
        }
      });
    });

    function sendToWhatsApp() {
      var text = inputEl ? inputEl.value.trim() : '';
      if (!text) return;
      var url = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(text);
      window.open(url, '_blank', 'noopener,noreferrer');
    }

    if (sendBtn) {
      sendBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        sendToWhatsApp();
      });
    }

    if (inputEl) {
      inputEl.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          sendToWhatsApp();
        }
      });
    }

    // Close when clicking outside
    document.addEventListener('click', function(e) {
      if (!chatCard.contains(e.target) && !triggerBtn.contains(e.target)) {
        if (!chatCard.hasAttribute('hidden')) {
          closeChat();
        }
      }
    });

    // Close on Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !chatCard.hasAttribute('hidden')) {
        closeChat();
        triggerBtn.focus();
      }
    });
  })();
</script>
