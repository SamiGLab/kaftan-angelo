---
import Icon from './Icon.astro';

interface Props {
  lang?: 'hu' | 'en';
}

const { lang = 'hu' } = Astro.props;
const hu = lang === 'hu';
const searchDataUrl = `/assets/data/home-search-${lang}.json`;
const catalogUrl = hu ? '/kollekciok/' : '/en/collections/';
const trending = hu
  ? ['báránybőr', 'fekete', 'irha', 'szőrme', 'férfi', 'barna']
  : ['lambskin', 'black', 'shearling', 'fur', 'men', 'brown'];
---

<dialog class="global-search-dialog" data-global-search-dialog aria-labelledby="global-search-title">
  <div class="gs-head">
    <h2 id="global-search-title">{hu ? 'Modellek keresése' : 'Search models'}</h2>
    <button type="button" class="gs-close" data-global-search-close aria-label={hu ? 'Keresés bezárása' : 'Close search'}>×</button>
  </div>
  <div class="gs-body">
    <div class="gs-input-wrap">
      <Icon name="search" class="gs-icon" />
      <input
        type="search"
        class="gs-input"
        data-global-search-input
        autocomplete="off"
        placeholder={hu ? 'Modell, szín vagy anyag (pl. fekete, báránybőr)…' : 'Model, colour or material (e.g. black, lambskin)…'}
        aria-label={hu ? 'Modellek keresése' : 'Search models'}
      />
    </div>
    <div class="gs-trending" role="group" aria-label={hu ? 'Népszerű keresések' : 'Popular searches'}>
      <span class="gs-trending-label">{hu ? 'Népszerű:' : 'Popular:'}</span>
      {trending.map((term) => (
        <button type="button" class="gs-chip" data-gs-chip={term}>{term}</button>
      ))}
    </div>
    <div class="gs-results" data-global-search-results aria-live="polite"></div>
    <div class="gs-foot">
      <a href={catalogUrl}>{hu ? 'Teljes kollekció megtekintése →' : 'Browse full collection →'}</a>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ searchDataUrl, catalogUrl, lang }}>
(() => {
  const dialog = document.querySelector('[data-global-search-dialog]');
  if (!dialog) return;
  const input = dialog.querySelector('[data-global-search-input]');
  const resultsEl = dialog.querySelector('[data-global-search-results]');
  const closeBtn = dialog.querySelector('[data-global-search-close]');
  if (!input || !resultsEl) return;

  const hu = lang === 'hu';
  let indexPromise = null;

  const loadIndex = () => {
    if (!indexPromise) {
      indexPromise = fetch(searchDataUrl).then((r) => (r.ok ? r.json() : [])).catch(() => []);
    }
    return indexPromise;
  };

  const esc = (s) =>
    String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const render = async (raw) => {
    const q = raw.trim().toLowerCase();
    if (!q) {
      resultsEl.innerHTML = '';
      return;
    }
    const items = await loadIndex();
    const tokens = q.split(/\s+/).filter(Boolean);
    const matches = items.filter((item) => tokens.every((t) => item.h.includes(t)));
    if (!matches.length) {
      resultsEl.innerHTML = `<p class="gs-empty">${
        hu ? 'Nincs találat erre a keresésre.' : 'No matching models found.'
      } <a href="${catalogUrl}">${hu ? 'Összes modell →' : 'All models →'}</a></p>`;
      return;
    }
    resultsEl.innerHTML = matches
      .slice(0, 8)
      .map(
        (m) => `<a class="gs-item" href="${esc(m.u)}">
          <img src="${esc(m.i)}" alt="" width="48" height="48" loading="lazy" decoding="async" />
          <span class="gs-item-meta">
            <strong>${esc(m.n)}</strong>
            <span>${esc(m.c)}${m.m ? ' · ' + esc(m.m) : ''}</span>
          </span>
        </a>`
      )
      .join('');
  };

  const openModal = () => {
    loadIndex();
    if (!dialog.open) dialog.showModal();
    input.focus();
  };

  document.addEventListener('click', (e) => {
    const trigger = e.target instanceof Element ? e.target.closest('[data-global-search-open]') : null;
    if (trigger) {
      e.preventDefault();
      openModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openModal();
    }
  });

  closeBtn?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  input.addEventListener('input', () => { render(input.value); });

  dialog.querySelectorAll('[data-gs-chip]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const term = chip.getAttribute('data-gs-chip') || '';
      input.value = term;
      input.focus();
      render(term);
    });
  });
})();
</script>

<style>
  :global(.header-search-trigger) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid #dcb27c4d;
    background: transparent;
    color: var(--cream, #efe4d2);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  :global(.header-search-trigger:hover) {
    border-color: var(--bright, #dcb27c);
    color: var(--bright, #dcb27c);
  }
  :global(.header-search-trigger .ui-icon) {
    width: 17px;
    height: 17px;
  }
  .global-search-dialog {
    width: min(640px, calc(100% - 24px));
    max-height: 86dvh;
    padding: 0;
    border: 1px solid #dcb27c66;
    border-radius: 14px;
    background: #1b120c;
    color: #efe4d2;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.55);
  }
  .global-search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }
  .gs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid #dcb27c2e;
  }
  .gs-head h2 {
    margin: 0;
    font-size: 1.15rem;
    color: #dcb27c;
  }
  .gs-close {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid #dcb27c55;
    background: transparent;
    color: #efe4d2;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .gs-body {
    padding: 1rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .gs-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    background: #241a12;
    border: 1px solid #dcb27c55;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
  }
  .gs-input-wrap:focus-within {
    border-color: #dcb27c;
  }
  .gs-body :global(.gs-icon) {
    color: #dcb27c;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .gs-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: #efe4d2;
    font-size: 0.95rem;
    outline: none;
    padding: 0.35rem 0;
  }
  .gs-input::placeholder {
    color: #c9bba5;
  }
  .gs-trending {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .gs-trending-label {
    font-size: 0.8rem;
    color: #c9bba5;
  }
  .gs-chip {
    background: #dcb27c14;
    border: 1px solid #dcb27c40;
    color: #efe4d2;
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.78rem;
    font-family: inherit;
    cursor: pointer;
  }
  .gs-chip:hover {
    border-color: #dcb27c;
    background: #dcb27c26;
  }
  .gs-results {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
    max-height: 46dvh;
    overflow-y: auto;
  }
  .gs-results :global(.gs-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem;
    border-radius: 8px;
    background: #241a12;
    border: 1px solid transparent;
    color: #efe4d2;
    text-decoration: none;
  }
  .gs-results :global(.gs-item:hover) {
    border-color: #dcb27c66;
  }
  .gs-results :global(.gs-item img) {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    object-fit: cover;
    object-position: center top;
    background: #e8e5df;
    flex-shrink: 0;
  }
  .gs-results :global(.gs-item-meta) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .gs-results :global(.gs-item-meta strong) {
    font-size: 0.9rem;
    line-height: 1.25;
  }
  .gs-results :global(.gs-item-meta span) {
    font-size: 0.78rem;
    color: #c9bba5;
  }
  .gs-results :global(.gs-empty) {
    margin: 0.25rem 0;
    font-size: 0.86rem;
    color: #c9bba5;
  }
  .gs-results :global(.gs-empty a),
  .gs-foot a {
    color: #dcb27c;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.86rem;
  }
  .gs-foot {
    padding-top: 0.5rem;
    border-top: 1px solid #dcb27c26;
    text-align: center;
  }
</style>
