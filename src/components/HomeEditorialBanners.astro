---
import models from '../data/models.json';

interface Props {
  lang: 'hu' | 'en';
}

const { lang } = Astro.props;
const hu = lang === 'hu';
const visibleModels = models.filter((m) => !m.catalogHidden);

const firstByCat = (huUrl: string) =>
  visibleModels.find((m) => m.category.hu.url === huUrl) ?? visibleModels[0];

const womenSample = firstByCat('/noi-borkabatok/');
const menSample = firstByCat('/ferfi-borkabatok/');
const shearlingSample = firstByCat('/irhakabatok/');

const toAvif = (image: string, size: number) =>
  '/assets/images/' + image.replace(/^\//, '').replace(/\.webp$/, `-${size}.avif`);
const toWebp = (image: string, size: number) =>
  '/assets/images/' + image.replace(/^\//, '').replace(/\.webp$/, `-${size}.webp`);
---

<section class="home-editorial-banners" aria-label={hu ? 'Válogatott kollekciók' : 'Selected collections'}>
  <div class="wrap">
    <div class="editorial-bento">
      <article class="bento-card bento-wide">
        <picture class="bento-media">
          <source srcset={`${toAvif(womenSample.image, 480)} 480w, ${toAvif(womenSample.image, 800)} 800w`} sizes="(max-width: 768px) 92vw, 620px" type="image/avif" />
          <source srcset={`${toWebp(womenSample.image, 480)} 480w, ${toWebp(womenSample.image, 800)} 800w`} sizes="(max-width: 768px) 92vw, 620px" type="image/webp" />
          <img src={womenSample.image} alt={hu ? 'Női bőrkabát kollekció' : 'Women’s leather jackets collection'} width="620" height="440" loading="lazy" decoding="async" />
        </picture>
        <div class="bento-overlay">
          <span class="tag mono">{hu ? 'Kiemelt kollekció' : 'Featured collection'}</span>
          <h2>{hu ? 'Női bőrkabátok' : 'Women’s Leather Jackets'}</h2>
          <p>
            {hu
              ? 'Klasszikus blézerek, karcsúsított dzsekik és kétoldalas fazonok valódi bárány- és velúrbőrből.'
              : 'Classic blazers, tailored jackets and reversible silhouettes in genuine lambskin and suede.'}
          </p>
          <a class="bento-link" href={hu ? '/noi-borkabatok/' : '/en/womens-leather-jackets/'}>
            {hu ? 'Kollekció megtekintése →' : 'Explore collection →'}
          </a>
        </div>
      </article>

      <div class="bento-stack">
        <article class="bento-card bento-small">
          <picture class="bento-media">
            <source srcset={`${toAvif(menSample.image, 480)} 480w, ${toAvif(menSample.image, 800)} 800w`} sizes="(max-width: 768px) 92vw, 440px" type="image/avif" />
            <source srcset={`${toWebp(menSample.image, 480)} 480w, ${toWebp(menSample.image, 800)} 800w`} sizes="(max-width: 768px) 92vw, 440px" type="image/webp" />
            <img src={menSample.image} alt={hu ? 'Férfi bőrkabát kollekció' : 'Men’s leather jackets collection'} width="440" height="210" loading="lazy" decoding="async" />
          </picture>
          <div class="bento-overlay">
            <span class="tag mono">{hu ? 'Férfi válogatás' : 'Men’s selection'}</span>
            <h3>{hu ? 'Férfi bőrkabátok' : 'Men’s Leather Jackets'}</h3>
            <a class="bento-link" href={hu ? '/ferfi-borkabatok/' : '/en/mens-leather-jackets/'}>
              {hu ? 'Modellek →' : 'View models →'}
            </a>
          </div>
        </article>

        <article class="bento-card bento-small">
          <picture class="bento-media">
            <source srcset={`${toAvif(shearlingSample.image, 480)} 480w, ${toAvif(shearlingSample.image, 800)} 800w`} sizes="(max-width: 768px) 92vw, 440px" type="image/avif" />
            <source srcset={`${toWebp(shearlingSample.image, 480)} 480w, ${toWebp(shearlingSample.image, 800)} 800w`} sizes="(max-width: 768px) 92vw, 440px" type="image/webp" />
            <img src={shearlingSample.image} alt={hu ? 'Irha- és szőrmekabátok' : 'Shearling and fur coats'} width="440" height="210" loading="lazy" decoding="async" />
          </picture>
          <div class="bento-overlay">
            <span class="tag mono">{hu ? 'Téli kollekció' : 'Winter outerwear'}</span>
            <h3>{hu ? 'Irha- és szőrmekabátok' : 'Shearling & Fur Coats'}</h3>
            <div class="bento-links-row">
              <a class="bento-link" href={hu ? '/irhakabatok/' : '/en/shearling-jackets/'}>
                {hu ? 'Irhakabátok →' : 'Shearling →'}
              </a>
              <a class="bento-link" href={hu ? '/szormekabatok/' : '/en/fur-coats/'}>
                {hu ? 'Szőrmekabátok →' : 'Fur coats →'}
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .home-editorial-banners {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--line, #efe4d229);
    background: #1b120c;
  }
  .editorial-bento {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 18px;
  }
  .bento-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 18px;
  }
  .bento-card {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #dcb27c33;
    background: var(--bg2, #241a12);
    display: flex;
    align-items: flex-end;
  }
  .bento-wide {
    min-height: 430px;
  }
  .bento-small {
    min-height: 206px;
  }
  .bento-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bento-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.35s ease;
  }
  .bento-card:hover .bento-media img {
    transform: scale(1.03);
  }
  .bento-overlay {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 2.25rem 1.5rem 1.4rem;
    background: linear-gradient(180deg, rgba(27, 18, 12, 0.08) 0%, rgba(27, 18, 12, 0.84) 44%, rgba(27, 18, 12, 0.96) 100%);
  }
  .bento-overlay .tag {
    color: #dcb27c;
  }
  .bento-overlay h2 {
    margin: 0.35rem 0 0.45rem;
    font-size: clamp(1.55rem, 2.6vw, 2.15rem);
    line-height: 1.15;
    color: #efe4d2;
  }
  .bento-overlay h3 {
    margin: 0.3rem 0 0.4rem;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.2;
    color: #efe4d2;
  }
  .bento-overlay p {
    margin: 0 0 0.85rem;
    max-width: 44ch;
    font-size: 0.92rem;
    color: #d8cab6;
    line-height: 1.5;
  }
  .bento-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.1rem;
  }
  .bento-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: #dcb27c;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .bento-link:hover,
  .bento-link:focus-visible {
    color: #efe4d2;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 820px) {
    .home-editorial-banners {
      padding: 1.25rem 0;
    }
    .home-editorial-banners :global(.wrap) {
      padding: 0 12px;
    }
    .editorial-bento {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .bento-stack {
      grid-template-rows: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .bento-wide {
      min-height: 270px;
    }
    .bento-small {
      min-height: 195px;
    }
    .bento-small .bento-overlay {
      padding: 1.25rem 0.85rem 0.9rem;
    }
    .bento-small h3 {
      font-size: 1rem;
    }
    .bento-small .bento-link {
      font-size: 0.78rem;
      min-height: 30px;
    }
  }
</style>
