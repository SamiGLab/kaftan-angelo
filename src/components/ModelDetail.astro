---
import Icon from './Icon.astro';
import { responsiveImages } from './responsive-images';

interface Props {
  page: any;
}

const { page } = Astro.props;
const lang = (page.lang ?? 'hu') as 'hu' | 'en';
const hu = lang === 'hu';
const model = page.model;
const name = model.names[lang];
const collection = model.category[lang].url;
const collectionLabel = model.category[lang].name;
const material = model.material?.[lang] ?? (hu ? 'A pontos anyagösszetételről kérdezzen üzletünkben.' : 'Ask our store about the exact material composition.');

const isWallet = model.slug === 'barna-bor-penztarca-budapest';
const isBelt = model.slug === 'fekete-borov-budapest';

const enquiryHint = isWallet
  ? (hu ? 'A termékoldalt küldje el WhatsAppon, és írja meg, milyen belső elrendezést és méretet keres.' : 'Send this product page on WhatsApp and describe the interior layout and dimensions you need.')
  : isBelt
    ? (hu ? 'A termékoldalt küldje el WhatsAppon a keresett övhosszal és szélességgel.' : 'Send this product page on WhatsApp with your required belt length and width.')
    : (hu ? 'A termékoldalt küldje el WhatsAppon a keresett mérettel és színnel.' : 'Send this product page on WhatsApp with your preferred size and colour.');

const message = `${hu ? 'Üdvözlöm! A képen látható termék áráról és elérhetőségéről szeretnék érdeklődni:' : 'Hello! Could you tell me the price and availability of the product pictured here:'} ${name}\n${page.canonical}`;

const checklist: string[] = page.checklist ?? [];
const related: any[] = page.related ?? [];

function renderPicture(pictureHtml: string, fullWidth = false, eager = false) {
  const transformed = fullWidth
    ? responsiveImages(pictureHtml).replace(/sizes="[^"]+"/g, 'sizes="(max-width: 760px) 92vw, (max-width: 1100px) 46vw, 600px"')
    : responsiveImages(pictureHtml);
  if (eager) {
    return transformed.replace('loading="lazy"', 'loading="eager" fetchpriority="high"');
  }
  return transformed;
}
---
<section class="pdp-section">
  <div class="wrap">
    <nav class="breadcrumbs model-breadcrumbs" aria-label={hu ? 'Morzsamenü' : 'Breadcrumb'}>
      <a href={hu ? '/' : '/en/'}>{hu ? 'Főoldal' : 'Home'}</a>
      <span aria-hidden="true">/</span>
      <a href={collection}>{collectionLabel}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{name}</span>
    </nav>

    <div class="model-detail">
      <div class="model-photo">
        {model.variants && model.variants.length > 0 ? (
          <>
            <div class="pdp-variant-picker" data-colour-selector hidden>
              <p class="pdp-variant-label">{hu ? 'Válasszon színt' : 'Choose a colour'}</p>
              <div class="colour-options">
                {model.variants.map((v: any, i: number) => (
                  <button type="button" class="btn btn-ghost" data-colour={v.key} aria-pressed={i === 0 ? "true" : "false"}>
                    {v.names[lang]}
                  </button>
                ))}
              </div>
              <p class="pdp-variant-status" role="status" data-colour-status></p>
            </div>
            {model.variants.map((v: any, i: number) => (
              <section class="model-colour-panel" data-colour-panel={v.key} data-colour-name={v.names[lang]} data-pdp-gallery>
                <h2 class="sr-only">{v.names[lang]}</h2>
                <div class="pdp-main-stage" data-pdp-stage>
                  <Fragment set:html={renderPicture(v.gallery[0].pictures[lang], true, i === 0)} />
                  <a class="pdp-zoom-pill" href={v.gallery[0].image} data-pdp-zoom-link aria-label={hu ? 'Teljes méretű fotó megnyitása' : 'Open full-size photo'}>
                    <Icon name="zoom" /><span>{hu ? 'Nagyítás' : 'Zoom'}</span>
                  </a>
                  {v.gallery.length > 1 && (
                    <span class="pdp-photo-counter" data-pdp-counter aria-live="polite">1 / {v.gallery.length}</span>
                  )}
                </div>
                <div class="model-gallery pdp-thumb-strip" role="group" aria-label={hu ? 'További fotók' : 'More photos'}>
                  {v.gallery.slice(1).map((photo: any, tIdx: number) => (
                    <figure class="pdp-thumb-item" data-pdp-thumb={photo.image} data-pdp-index={tIdx + 2}>
                      <Fragment set:html={renderPicture(photo.pictures[lang])} />
                      <figcaption>
                        <a href={photo.image} class="pdp-thumb-link">
                          {photo.labels[lang]}
                        </a>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            ))}
          </>
        ) : (
          <div class="pdp-single-gallery" data-pdp-gallery>
            <div class="pdp-main-stage" data-pdp-stage>
              <Fragment set:html={renderPicture(model.pictures[lang], true, true)} />
              <a class="pdp-zoom-pill" href={model.image} data-pdp-zoom-link aria-label={hu ? 'Teljes méretű fotó megnyitása' : 'Open full-size photo'}>
                <Icon name="zoom" /><span>{hu ? 'Teljes méretű fotó' : 'Full-size photo'}</span>
              </a>
              {model.gallery && model.gallery.length > 1 && (
                <span class="pdp-photo-counter" data-pdp-counter aria-live="polite">1 / {model.gallery.length}</span>
              )}
            </div>
            {model.gallery && model.gallery.length > 1 && (
              <div class="model-gallery pdp-thumb-strip" role="group" aria-label={hu ? 'Termékfotók' : 'Product photos'}>
                {model.gallery.slice(1).map((photo: any, tIdx: number) => (
                  <figure class="pdp-thumb-item" data-pdp-thumb={photo.image} data-pdp-index={tIdx + 2}>
                    <Fragment set:html={renderPicture(photo.pictures[lang])} />
                    <figcaption>
                      <a href={photo.image} class="pdp-thumb-link">
                        {photo.labels[lang]}
                      </a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
          </div>
        )}
        {model.video?.src && (
          <div class="model-video-card" data-model-video={model.video.src}>
            <button type="button" class="model-video-trigger" data-video-play aria-label={hu ? `Videó lejátszása: ${name}` : `Play video: ${name}`}>
              <img src={model.video.poster ?? model.image} alt="" width="480" height="600" loading="lazy" decoding="async" />
              <span class="model-video-badge">▶ {hu ? 'Videó megtekintése' : 'Watch video'}{model.video.duration ? ` (${model.video.duration})` : ''}</span>
            </button>
          </div>
        )}
      </div>

      <div class="model-info">
        <h1>{name}</h1>
        <p class="model-material" data-model-material="true">
          <span class="pdp-meta-label">{hu ? 'Kategória:' : 'Category:'}</span> <a href={collection}>{collectionLabel}</a>
          <span class="pdp-meta-sep" aria-hidden="true">·</span>
          <span>{material}</span>
        </p>

        <p class="model-enquiry-summary">
          {hu ? 'Érdeklődjön a kiválasztott darab áráról, méretéről és elérhetőségéről. Az üzlet személyesen erősíti meg a részleteket.' : 'Ask about the price, size and availability of this piece. Our store will confirm the details directly.'}
        </p>

        <div class="model-enquiry-fields" data-model-enquiry-fields>
          <label>
            <span>{hu ? (isBelt ? 'Övhossz (opcionális)' : isWallet ? 'Kívánt méret (opcionális)' : 'Keresett méret (opcionális)') : (isBelt ? 'Belt length (optional)' : 'Preferred size (optional)')}</span>
            <input type="text" data-enquiry-size maxlength="40" autocomplete="off" placeholder={hu ? 'Pl. M, L vagy cm' : 'e.g. M, L or cm'} />
          </label>
          {(!model.variants || model.variants.length === 0) && (
            <label>
              <span>{hu ? 'Keresett szín (opcionális)' : 'Preferred colour (optional)'}</span>
              <input type="text" data-enquiry-colour maxlength="40" autocomplete="off" placeholder={hu ? 'Pl. fekete' : 'e.g. black'} />
            </label>
          )}
        </div>

        {!isWallet && !isBelt && (
          <div class="size-guide-row">
            <button type="button" class="size-guide-trigger" data-size-guide-open>
              <Icon name="ruler" /><span>{hu ? 'Méret- és próbaútmutató' : 'Size & fitting guide'}</span>
            </button>
          </div>
        )}

        <div class="actions pdp-cta-row" data-model-primary-actions>
          <a class="btn btn-primary" data-model-inquiry data-interest-source="model_detail" href={`https://wa.me/36203593216?text=${encodeURIComponent(message)}`}>
            <Icon name="message" />{hu ? 'Érdeklődés WhatsAppon' : 'Ask on WhatsApp'}
          </a>
          <a class="btn btn-ghost" href={hu ? '/uzlet/' : '/en/visit/'}>
            <Icon name="location" />{hu ? (isWallet || isBelt ? 'Nézze meg üzletünkben' : 'Próbálja fel üzletünkben') : 'Visit our store'}
          </a>
          <a class="btn btn-ghost" href="tel:+3612667274" aria-label={hu ? 'Üzlet hívása: +36 1 266 7274' : 'Call the store: +36 1 266 7274'}>+36&nbsp;1&nbsp;266&nbsp;7274</a>
        </div>

        <p class="model-intro">{model.intro[lang]}</p>

        <div class="pdp-utility-row">
          <button type="button" class="pdp-utility-btn model-save-btn" data-detail-save={model.slug} aria-pressed="false">
            ♡ {hu ? 'Próbalistára' : 'Save to list'}
          </button>
          <a class="pdp-utility-link" href={collection}>
            {hu ? 'Összes modell a kategóriában →' : 'All models in category →'}
          </a>
        </div>

        <div class="pdp-store-box">
          <div class="pdp-store-row">
            <div class="pdp-store-copy">
              <strong>Kaftan Angelo · Budapest</strong>
              <span>Kossuth Lajos u. 18, 1053 Budapest ({hu ? 'Belváros, Ferenciek tere közelében' : 'City centre, near Ferenciek tere'})</span>
            </div>
            <a href={hu ? '/uzlet/' : '/en/visit/'}>{hu ? 'Útvonal' : 'Directions'}</a>
          </div>
          <div class="pdp-store-row">
            <div class="pdp-store-copy">
              <strong>{hu ? 'Kapcsolódó útmutató' : 'Related guide'}</strong>
              <span>{model.guide[lang].name}</span>
            </div>
            <a href={model.guide[lang].url}>{hu ? 'Olvasás' : 'Read'}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="pdp-tabs-box" data-pdp-tabs>
      <div class="pdp-tab-bar" role="tablist" aria-label={hu ? 'Termék részletek' : 'Product details'}>
        <button type="button" role="tab" id="pdp-tab-advice" aria-controls="pdp-panel-advice" aria-selected="true" class="pdp-tab is-active" data-pdp-tab="advice">
          {hu ? 'Mire figyeljen választáskor?' : 'What to check when choosing'}
        </button>
        <button type="button" role="tab" id="pdp-tab-avail" aria-controls="pdp-panel-avail" aria-selected="false" class="pdp-tab" data-pdp-tab="avail">
          {hu ? 'Ár, méret és elérhetőség' : 'Price, size and availability'}
        </button>
      </div>

      <div class="pdp-tab-panel" id="pdp-panel-advice" role="tabpanel" aria-labelledby="pdp-tab-advice" data-pdp-panel="advice">
        <h2>{hu ? 'Mire figyeljen választáskor?' : 'What to check when choosing'}</h2>
        <p>{model.advice[lang]}</p>
        {checklist.length > 0 && (
          <>
            <h3>{hu ? 'Hasznos kérdések a kiválasztott darabról' : 'Questions about the specific piece'}</h3>
            <ul class="model-checklist">
              {checklist.map((text: string) => <li>{text}</li>)}
            </ul>
          </>
        )}
      </div>

      <div class="pdp-tab-panel" id="pdp-panel-avail" role="tabpanel" aria-labelledby="pdp-tab-avail" data-pdp-panel="avail" hidden>
        <h2>{hu ? 'Ár, méret és elérhetőség' : 'Price, size and availability'}</h2>
        <p>{enquiryHint}</p>
        <p data-model-availability="true">
          {hu ? 'Kérjen megerősítést a kiválasztott darabról. Az aktuális árat, méreteket és színeket az üzlet tudja megerősíteni; a fotó nem valós idejű készletjelzés.' : 'Ask for confirmation about the selected piece. Our store can confirm the current price, sizes and colours; the photo does not indicate real-time stock.'}
        </p>
        <p>
          {hu ? 'Üzletünk és próbalehetőség: ' : 'Store fitting and viewing: '}
          <a href={hu ? '/uzlet/' : '/en/visit/'}>
            <Icon name="location" />Kossuth Lajos u. 18, 1053 Budapest
          </a>
          {hu ? ' (Belváros, Ferenciek tere közelében).' : ' (Belváros / city centre, near Ferenciek tere).'}
        </p>
      </div>
    </div>

    {related.length > 0 && (
      <div class="model-related pdp-related-full">
        <h2>{hu ? 'Hasonlítsa össze más modellekkel' : 'Compare with other models'}</h2>
        <ul class="model-related-list">
          {related.map((other: any) => (
            <li>
              <a class="model-related-card" href={`${hu ? '/modellek/' : '/en/models/'}${other.slugs[lang]}/`}>
                <div class="model-related-photo">
                  <Fragment set:html={renderPicture(other.pictures[lang])} />
                </div>
                <span class="model-related-cat">{other.category?.[lang]?.name ?? collectionLabel}</span>
                <span class="model-related-name">{other.names[lang]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <section class="pdp-recent-full" data-recently-viewed hidden aria-labelledby="pdp-recent-heading">
      <h2 id="pdp-recent-heading">{hu ? 'Legutóbb megtekintett modellek' : 'Recently viewed models'}</h2>
      <ul class="pdp-recent-list" data-recently-viewed-list></ul>
    </section>
  </div>

  <dialog
    class="pdp-lightbox-dialog"
    data-pdp-lightbox
    aria-label={hu ? 'Teljes képernyős termékgaléria' : 'Fullscreen product gallery'}
  >
    <div class="lb-shell">
      <div class="lb-head">
        <div class="lb-meta">
          <span class="lb-counter" data-lb-counter>1 / 1</span>
          <span class="lb-caption" data-lb-caption>{name}</span>
        </div>
        <div class="lb-controls">
          <button type="button" class="lb-btn" data-lb-zoom aria-pressed="false" aria-label={hu ? 'Nagyítás váltása' : 'Toggle zoom'}>
            <Icon name="zoom" />
            <span data-lb-zoom-label>2×</span>
          </button>
          <button type="button" class="lb-btn lb-close" data-lb-close aria-label={hu ? 'Galéria bezárása' : 'Close gallery'}>
            <Icon name="x" />
          </button>
        </div>
      </div>
      <div class="lb-stage-wrap">
        <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label={hu ? 'Előző fotó' : 'Previous photo'}>‹</button>
        <div class="lb-stage" data-lb-stage>
          <img class="lb-img" data-lb-img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt={name} decoding="async" />
        </div>
        <button type="button" class="lb-nav lb-next" data-lb-next aria-label={hu ? 'Következő fotó' : 'Next photo'}>›</button>
      </div>
      <div class="lb-thumbs" data-lb-thumbs role="group" aria-label={hu ? 'Galéria nézőképek' : 'Gallery thumbnails'}></div>
    </div>
  </dialog>

  {!isWallet && !isBelt && (
    <dialog class="size-guide-dialog" data-size-guide-dialog aria-labelledby="size-guide-title">
      <div class="sg-head">
        <h2 id="size-guide-title">{hu ? 'Méret- és próbaútmutató' : 'Size & fitting guide'}</h2>
        <button type="button" class="sg-close" data-size-guide-close aria-label={hu ? 'Bezárás' : 'Close'}>×</button>
      </div>
      <div class="sg-body">
        <p>{hu ? 'A valódi bőr és irha kabátok szabása modellenként eltérhet. Az alábbi tájékoztató táblázat segít a kiinduló méret meghatározásában; a pontos illeszkedést személyes próbán ellenőrizheti. Az esetleges méretre igazításról az adott modell alapján egyeztetünk.' : 'Genuine leather and shearling cuts vary by model. Use this reference chart as a starting point; check the fit in person and ask which adjustments are possible for the individual garment.'}</p>
        <div class="sg-table-wrap">
          <table class="sg-table">
            <thead>
              <tr>
                <th>{hu ? 'Méret' : 'Size'}</th>
                <th>EU</th>
                <th>{hu ? 'Mellbőség (cm)' : 'Chest (cm)'}</th>
                <th>{hu ? 'Derék (cm)' : 'Waist (cm)'}</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>XS</td><td>34 / 44</td><td>82–86</td><td>66–70</td></tr>
              <tr><td>S</td><td>36 / 46</td><td>87–92</td><td>71–76</td></tr>
              <tr><td>M</td><td>38 / 48</td><td>93–98</td><td>77–82</td></tr>
              <tr><td>L</td><td>40 / 50</td><td>99–104</td><td>83–88</td></tr>
              <tr><td>XL</td><td>42 / 52</td><td>105–110</td><td>89–95</td></tr>
              <tr><td>2XL</td><td>44 / 54</td><td>111–118</td><td>96–103</td></tr>
            </tbody>
          </table>
        </div>
        <p class="sg-note">
          {hu ? 'Kossuth Lajos u. 18, Budapest · ' : 'Kossuth Lajos u. 18, Budapest · '}
          <a href={hu ? '/utmutatok/borkabat-meret-utmutato/' : '/en/guides/leather-jacket-fit-guide/'}>
            {hu ? 'Részletes méret- és fazonútmutató →' : 'Full leather jacket fit guide →'}
          </a>
        </p>
      </div>
    </dialog>
  )}

  <aside class="model-sticky-bar" data-model-sticky-bar hidden aria-label={hu ? 'Gyors érdeklődés' : 'Quick inquiry'}>
    <div class="model-sticky-inner">
      <div class="model-sticky-left">
        <img
          class="model-sticky-thumb"
          src={`/assets/images/${model.image.replace(/^\//, '').replace(/\.webp$/, '-480.webp')}`}
          alt=""
          width="44"
          height="54"
          loading="lazy"
          decoding="async"
        />
        <div class="model-sticky-meta">
          <strong>{name}</strong>
          <span>{material}</span>
        </div>
      </div>
      <div class="model-sticky-actions">
        <button type="button" class="btn btn-ghost model-save-btn" data-detail-save={model.slug} aria-pressed="false">
          ♡ {hu ? 'Lista' : 'Save'}
        </button>
        <a class="btn btn-ghost model-sticky-visit" href={hu ? '/uzlet/' : '/en/visit/'}>
          {hu ? 'Üzlet' : 'Visit'}
        </a>
        <a class="btn btn-primary" data-interest-source="model_sticky_bar" href={`https://wa.me/36203593216?text=${encodeURIComponent(message)}`}>
          {hu ? 'WhatsApp érdeklődés' : 'Ask on WhatsApp'}
        </a>
      </div>
    </div>
  </aside>
</section>

<script is:inline define:vars={{ lang, modelSlug: model.slug, modelName: name }}>
(() => {
  const hu = lang === 'hu';
  const FITTING_LIST_ID = 'kaftan_fitting_list_v1';
  const RECENT_LIST_ID = 'kaftan_recent_models_v1';
  const LIMIT = 12;

  // Fullscreen accessible gallery lightbox (zoom + prev/next + keyboard + swipe)
  const lbDialog = document.querySelector('[data-pdp-lightbox]');
  const lbImg = lbDialog?.querySelector('[data-lb-img]');
  const lbStage = lbDialog?.querySelector('[data-lb-stage]');
  const lbCounter = lbDialog?.querySelector('[data-lb-counter]');
  const lbCaption = lbDialog?.querySelector('[data-lb-caption]');
  const lbThumbs = lbDialog?.querySelector('[data-lb-thumbs]');
  const lbPrev = lbDialog?.querySelector('[data-lb-prev]');
  const lbNext = lbDialog?.querySelector('[data-lb-next]');
  const lbZoom = lbDialog?.querySelector('[data-lb-zoom]');
  const lbZoomLabel = lbDialog?.querySelector('[data-lb-zoom-label]');
  const lbClose = lbDialog?.querySelector('[data-lb-close]');

  let lbItems = [];
  let lbIdx = 0;
  let lbZoomed = false;
  let lbTrigger = null;

  const setZoom = (zoomed) => {
    lbZoomed = zoomed;
    lbStage?.classList.toggle('is-zoomed', zoomed);
    lbZoom?.setAttribute('aria-pressed', zoomed ? 'true' : 'false');
    if (lbZoomLabel) lbZoomLabel.textContent = zoomed ? '1×' : '2×';
    if (!zoomed && lbStage) { lbStage.scrollTop = 0; lbStage.scrollLeft = 0; }
  };

  const renderLightbox = () => {
    if (!lbItems.length || !lbImg) return;
    const cur = lbItems[lbIdx];
    lbImg.src = cur.src;
    lbImg.alt = cur.label || modelName;
    if (lbCounter) lbCounter.textContent = `${lbIdx + 1} / ${lbItems.length}`;
    if (lbCaption) lbCaption.textContent = cur.label || modelName;
    setZoom(false);
    const multi = lbItems.length > 1;
    if (lbPrev) lbPrev.hidden = !multi;
    if (lbNext) lbNext.hidden = !multi;
    if (lbThumbs) {
      lbThumbs.hidden = !multi;
      lbThumbs.innerHTML = multi
        ? lbItems
            .map(
              (item, idx) => `<button type="button" class="lb-thumb${idx === lbIdx ? ' is-active' : ''}" data-lb-jump="${idx}" aria-label="${hu ? `Fotó ${idx + 1}` : `Photo ${idx + 1}`}">
                <img src="${item.thumb || item.src}" alt="" width="56" height="70" loading="lazy" />
              </button>`
            )
            .join('')
        : '';
    }
  };

  const collectGalleryItems = (gallery) => {
    const items = [];
    const stageImg = gallery.querySelector('[data-pdp-stage] img');
    const zoomHref = gallery.querySelector('[data-pdp-zoom-link]')?.getAttribute('href');
    if (stageImg) {
      items.push({
        src: zoomHref || stageImg.currentSrc || stageImg.getAttribute('src') || '',
        thumb: stageImg.getAttribute('src') || '',
        label: stageImg.getAttribute('alt') || modelName,
      });
    }
    gallery.querySelectorAll('[data-pdp-thumb]').forEach((thumb) => {
      const link = thumb.querySelector('.pdp-thumb-link');
      const img = thumb.querySelector('img');
      const src = link?.getAttribute('href') || thumb.getAttribute('data-pdp-thumb') || img?.getAttribute('src') || '';
      if (src) {
        items.push({
          src,
          thumb: img?.getAttribute('src') || src,
          label: link?.textContent?.trim() || img?.getAttribute('alt') || modelName,
        });
      }
    });
    return items;
  };

  const openLightbox = (gallery, startIdx = 0, trigger = null) => {
    if (!lbDialog) return;
    lbItems = collectGalleryItems(gallery);
    if (!lbItems.length) return;
    lbIdx = Math.max(0, Math.min(startIdx, lbItems.length - 1));
    lbTrigger = trigger instanceof HTMLElement ? trigger : document.activeElement;
    window.dispatchEvent(new CustomEvent('kaftan-close-overlays', { detail: { except: 'lightbox' } }));
    renderLightbox();
    if (!lbDialog.open) lbDialog.showModal();
    requestAnimationFrame(() => lbClose?.focus());
  };

  const closeLightbox = (restoreFocus = true) => {
    setZoom(false);
    if (lbDialog?.open) lbDialog.close();
    if (restoreFocus && lbTrigger instanceof HTMLElement) lbTrigger.focus();
  };

  const stepLightbox = (delta) => {
    if (lbItems.length < 2) return;
    lbIdx = (lbIdx + delta + lbItems.length) % lbItems.length;
    renderLightbox();
  };

  lbPrev?.addEventListener('click', () => stepLightbox(-1));
  lbNext?.addEventListener('click', () => stepLightbox(1));
  lbZoom?.addEventListener('click', () => setZoom(!lbZoomed));
  lbImg?.addEventListener('click', () => setZoom(!lbZoomed));
  lbClose?.addEventListener('click', () => closeLightbox(true));
  lbThumbs?.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest('[data-lb-jump]') : null;
    if (!btn) return;
    lbIdx = Number(btn.getAttribute('data-lb-jump')) || 0;
    renderLightbox();
  });
  lbDialog?.addEventListener('click', (e) => {
    if (e.target === lbDialog) closeLightbox(true);
  });
  lbDialog?.addEventListener('cancel', () => {
    setZoom(false);
    if (lbTrigger instanceof HTMLElement) requestAnimationFrame(() => lbTrigger.focus());
  });
  lbDialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); stepLightbox(-1); }
    else if (e.key === 'ArrowRight') { e.preventDefault(); stepLightbox(1); }
    else if (e.key === '+' || e.key === '=') { e.preventDefault(); setZoom(true); }
    else if (e.key === '-') { e.preventDefault(); setZoom(false); }
  });
  let touchStartX = 0;
  lbStage?.addEventListener('touchstart', (e) => {
    if (!lbZoomed && e.touches.length === 1) touchStartX = e.touches[0].clientX;
  }, { passive: true });
  lbStage?.addEventListener('touchend', (e) => {
    if (lbZoomed || !touchStartX) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    touchStartX = 0;
    if (Math.abs(dx) > 48) stepLightbox(dx < 0 ? 1 : -1);
  }, { passive: true });
  window.addEventListener('kaftan-close-overlays', (e) => {
    if (e.detail?.except !== 'lightbox' && lbDialog?.open) closeLightbox(false);
  });

  // Interactive thumbnail click swaps photo in main stage & opens lightbox on zoom/stage click
  document.querySelectorAll('[data-pdp-gallery]').forEach((gallery) => {
    const stage = gallery.querySelector('[data-pdp-stage]');
    const zoomLink = gallery.querySelector('[data-pdp-zoom-link]');
    const counter = gallery.querySelector('[data-pdp-counter]');
    const thumbs = Array.from(gallery.querySelectorAll('[data-pdp-thumb]'));
    if (!stage) return;

    zoomLink?.addEventListener('click', (e) => {
      e.preventDefault();
      openLightbox(gallery, 0, zoomLink);
    });
    const stagePicInit = stage.querySelector('picture');
    if (stagePicInit) {
      stagePicInit.style.cursor = 'zoom-in';
      stagePicInit.addEventListener('click', () => openLightbox(gallery, 0, zoomLink || stage));
    }

    if (!thumbs.length) return;
    let stageNum = 1;
    const total = thumbs.length + 1;
    thumbs.forEach((thumb, tIdx) => {
      const pic = thumb.querySelector('picture');
      const link = thumb.querySelector('.pdp-thumb-link');
      link?.addEventListener('click', (e) => {
        e.preventDefault();
        openLightbox(gallery, tIdx + 1, link);
      });
      if (!pic) return;
      pic.style.cursor = 'pointer';
      pic.addEventListener('click', () => {
        const stagePic = stage.querySelector('picture');
        if (!stagePic) return;
        const stageImg = stagePic.querySelector('img');
        const thumbImg = pic.querySelector('img');
        if (!stageImg || !thumbImg) return;
        const stageHtml = stagePic.innerHTML;
        const thumbHtml = pic.innerHTML;
        stagePic.innerHTML = thumbHtml;
        pic.innerHTML = stageHtml;
        const thumbNum = Number(thumb.getAttribute('data-pdp-index')) || 2;
        thumb.setAttribute('data-pdp-index', String(stageNum));
        stageNum = thumbNum;
        if (counter) counter.textContent = `${stageNum} / ${total}`;
        const newMainSrc = stagePic.querySelector('img')?.getAttribute('src');
        if (zoomLink && newMainSrc) zoomLink.setAttribute('href', newMainSrc);
        thumbs.forEach((t) => t.classList.remove('is-swapped'));
        thumb.classList.add('is-swapped');
      });
    });
  });

  // Recently viewed models (localStorage only, zero cookies)
  (() => {
    try {
      const prev = JSON.parse(localStorage.getItem(RECENT_LIST_ID) || '[]');
      const list = Array.isArray(prev) ? prev.filter((s) => typeof s === 'string' && s !== modelSlug) : [];
      const updated = [modelSlug, ...list].slice(0, 6);
      localStorage.setItem(RECENT_LIST_ID, JSON.stringify(updated));
      const others = list.slice(0, 4);
      const wrap = document.querySelector('[data-recently-viewed]');
      const ul = document.querySelector('[data-recently-viewed-list]');
      if (!others.length || !wrap || !ul) return;
      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      fetch(`/assets/data/home-search-${lang}.json`)
        .then((r) => (r.ok ? r.json() : []))
        .then((catalog) => {
          const bySlug = new Map(catalog.map((item) => [item.s, item]));
          const cards = others.map((slug) => bySlug.get(slug)).filter(Boolean);
          if (!cards.length) return;
          ul.innerHTML = cards
            .map(
              (m) => `<li>
                <a class="pdp-recent-card" href="${esc(m.u)}">
                  <div class="pdp-recent-photo"><img src="${esc(m.i)}" alt="${esc(m.n)}" width="240" height="300" loading="lazy" decoding="async" /></div>
                  <span class="pdp-recent-cat">${esc(m.c)}</span>
                  <span class="pdp-recent-name">${esc(m.n)}</span>
                </a>
              </li>`
            )
            .join('');
          wrap.hidden = false;
        })
        .catch(() => {});
    } catch {}
  })();

  // Below-the-fold horizontal tabs
  const tabRoot = document.querySelector('[data-pdp-tabs]');
  if (tabRoot) {
    const tabs = Array.from(tabRoot.querySelectorAll('[data-pdp-tab]'));
    const panels = Array.from(tabRoot.querySelectorAll('[data-pdp-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-pdp-tab');
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.hidden = p.getAttribute('data-pdp-panel') !== target;
        });
      });
    });
  }

  // Size guide modal
  const sgOpen = document.querySelector('[data-size-guide-open]');
  const sgDialog = document.querySelector('[data-size-guide-dialog]');
  const sgClose = document.querySelector('[data-size-guide-close]');
  if (sgOpen && sgDialog) {
    sgOpen.addEventListener('click', () => { if (!sgDialog.open) sgDialog.showModal(); });
    sgClose?.addEventListener('click', () => sgDialog.close());
    sgDialog.addEventListener('click', (e) => { if (e.target === sgDialog) sgDialog.close(); });
  }

  // Lazy video loader (zero LCP impact)
  document.querySelectorAll('[data-model-video]').forEach((wrap) => {
    const btn = wrap.querySelector('[data-video-play]');
    btn?.addEventListener('click', () => {
      const src = wrap.getAttribute('data-model-video');
      if (!src) return;
      const video = document.createElement('video');
      video.src = src;
      video.controls = true;
      video.autoplay = true;
      video.muted = true;
      video.playsInline = true;
      video.loop = true;
      video.className = 'model-video-player';
      wrap.replaceChildren(video);
    });
  });

  // Fitting list sync on model detail buttons
  const readList = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(FITTING_LIST_ID) || '[]');
      return new Set(Array.isArray(parsed) ? parsed.slice(0, LIMIT) : []);
    } catch { return new Set(); }
  };
  const saveButtons = Array.from(document.querySelectorAll('[data-detail-save]'));
  const syncSaves = () => {
    const list = readList();
    saveButtons.forEach((btn) => {
      const key = btn.getAttribute('data-detail-save');
      const saved = key ? list.has(key) : false;
      btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      const isCompact = btn.closest('[data-model-sticky-bar]') !== null;
      btn.textContent = saved
        ? (isCompact ? (hu ? '♥ Mentve' : '♥ Saved') : (hu ? '♥ Próbalistán' : '♥ On fitting list'))
        : (isCompact ? (hu ? '♡ Lista' : '♡ Save') : (hu ? '♡ Próbalistára' : '♡ Save to list'));
    });
  };
  saveButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-detail-save');
      if (!key) return;
      const list = readList();
      if (list.has(key)) list.delete(key);
      else if (list.size < LIMIT) list.add(key);
      try { localStorage.setItem(FITTING_LIST_ID, JSON.stringify([...list])); } catch {}
      window.dispatchEvent(new Event('kaftan-fitting-change'));
      syncSaves();
    });
  });
  window.addEventListener('kaftan-fitting-change', syncSaves);
  syncSaves();

  // Sticky bottom action bar when primary actions scroll out of view
  const actionsEl = document.querySelector('[data-model-primary-actions]');
  const stickyBar = document.querySelector('[data-model-sticky-bar]');
  if (actionsEl && stickyBar && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      const entry = entries[0];
      stickyBar.hidden = entry.isIntersecting || entry.boundingClientRect.top > 0;
    }, { threshold: 0 });
    io.observe(actionsEl);
  }
})();
</script>

