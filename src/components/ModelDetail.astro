---
import Icon from './Icon.astro';
import { responsiveImages } from './responsive-images';

interface Props {
  page: any;
}

const { page } = Astro.props;
const lang = (page.lang ?? 'hu') as 'hu' | 'en';
const hu = lang === 'hu';
const model = page.model;
const name = model.names[lang];
const collection = model.category[lang].url;
const collectionLabel = model.category[lang].name;
const isShearling = collection.includes('irha') || collection.includes('shearling');
const isFur = collection.includes('szorme') || collection.includes('fur');
const material = isShearling
  ? (hu ? 'Valódi báránybőr, irha' : 'Genuine shearling, lambskin')
  : isFur
    ? (hu ? 'Valódi szőrme' : 'Genuine fur')
    : (hu ? 'Valódi bőr' : 'Genuine leather');

const isWallet = model.slug === 'barna-bor-penztarca-budapest';
const isBelt = model.slug === 'fekete-borov-budapest';

const enquiryHint = isWallet
  ? (hu ? 'A termékoldalt küldje el WhatsAppon, és írja meg, milyen belső elrendezést és méretet keres.' : 'Send this product page on WhatsApp and describe the interior layout and dimensions you need.')
  : isBelt
    ? (hu ? 'A termékoldalt küldje el WhatsAppon a keresett övhosszal és szélességgel.' : 'Send this product page on WhatsApp with your required belt length and width.')
    : (hu ? 'A termékoldalt küldje el WhatsAppon a keresett mérettel és színnel.' : 'Send this product page on WhatsApp with your preferred size and colour.');

const message = `${hu ? 'Üdvözlöm! A képen látható termék áráról és elérhetőségéről szeretnék érdeklődni:' : 'Hello! Could you tell me the price and availability of the product pictured here:'} ${name}\n${page.canonical}`;

const checklist: string[] = page.checklist ?? [];
const related: any[] = page.related ?? [];

function renderPicture(pictureHtml: string, eager = false) {
  const transformed = responsiveImages(pictureHtml);
  if (eager) {
    return transformed.replace('loading="lazy"', 'loading="eager" fetchpriority="high"');
  }
  return transformed;
}
---
<section>
  <div class="wrap">
    <div class="breadcrumbs">
      <a href={collection}>← {collectionLabel}</a>
    </div>
    <div class="model-detail">
      <div class="model-photo">
        {model.variants && model.variants.length > 0 ? (
          <>
            <div data-colour-selector hidden>
              <p>{hu ? 'Válasszon színt' : 'Choose a colour'}</p>
              <div class="colour-options">
                {model.variants.map((v: any, i: number) => (
                  <button type="button" class="btn btn-ghost" data-colour={v.key} aria-pressed={i === 0 ? "true" : "false"}>
                    {v.names[lang]}
                  </button>
                ))}
              </div>
              <p role="status" data-colour-status></p>
            </div>
            {model.variants.map((v: any, i: number) => (
              <section class="model-colour-panel" data-colour-panel={v.key} data-colour-name={v.names[lang]}>
                <h2>{v.names[lang]}</h2>
                <Fragment set:html={renderPicture(v.gallery[0].pictures[lang], i === 0)} />
                <div class="model-gallery">
                  {v.gallery.slice(1).map((photo: any) => (
                    <figure>
                      <Fragment set:html={renderPicture(photo.pictures[lang])} />
                      <figcaption>
                        <a href={photo.image}>
                          <Icon name="zoom" />{photo.labels[lang]}
                        </a>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            ))}
          </>
        ) : (
          <>
            <Fragment set:html={renderPicture(model.pictures[lang], true)} />
            <a class="text-link" href={model.image}>
              <Icon name="zoom" />{hu ? 'Teljes méretű fotó megnyitása' : 'Open full-size photo'}
            </a>
            {model.gallery && model.gallery.length > 1 && (
              <div class="model-gallery" role="group" aria-label={hu ? 'Termékfotók' : 'Product photos'}>
                {model.gallery.slice(1).map((photo: any) => (
                  <figure>
                    <Fragment set:html={renderPicture(photo.pictures[lang])} />
                    <figcaption>
                      <a href={photo.image}>
                        <Icon name="zoom" />{photo.labels[lang]}
                      </a>
                    </figcaption>
                  </figure>
                ))}
              </div>
            )}
          </>
        )}
      </div>
      <div class="model-info">
        <span class="tag mono">Kaftan Angelo · Budapest</span>
        <h1>{name}</h1>
        <p class="model-material" data-model-material="true">
          <strong>{hu ? 'Anyag és kategória: ' : 'Material &amp; category: '}</strong>{material} · {collectionLabel}
        </p>
        <p>{model.intro[lang]}</p>
        <div class="actions">
          <a class="btn btn-primary" data-model-inquiry href={`https://wa.me/36203593216?text=${encodeURIComponent(message)}`}>
            {hu ? 'Érdeklődés erről a termékről' : 'Ask about this product'}
          </a>
          <a class="btn btn-ghost" href={hu ? '/uzlet/' : '/en/visit/'}>
            <Icon name="location" />{hu ? (isWallet || isBelt ? 'Nézze meg üzletünkben' : 'Próbálja fel üzletünkben') : 'Visit our store'}
          </a>
        </div>
        <h2>{hu ? 'Mire figyeljen választáskor?' : 'What to check when choosing'}</h2>
        <p>{model.advice[lang]}</p>
        {checklist.length > 0 && (
          <>
            <h2>{hu ? 'Hasznos kérdések a kiválasztott darabról' : 'Questions about the specific piece'}</h2>
            <ul class="model-checklist">
              {checklist.map((text: string) => <li>{text}</li>)}
            </ul>
          </>
        )}
        <h2>{hu ? 'Ár, méret és elérhetőség' : 'Price, size and availability'}</h2>
        <p>{enquiryHint}</p>
        <p data-model-availability="true">
          {hu ? 'Kérjen megerősítést a kiválasztott darabról. Az aktuális árat, méreteket és színeket az üzlet tudja megerősíteni; a fotó nem valós idejű készletjelzés.' : 'Ask for confirmation about the selected piece. Our store can confirm the current price, sizes and colours; the photo does not indicate real-time stock.'}
        </p>
        <p>
          {hu ? 'Üzletünk és próbalehetőség: ' : 'Store fitting and viewing: '}
          <a href={hu ? '/uzlet/' : '/en/visit/'}>
            <Icon name="location" />Kossuth Lajos u. 18, 1053 Budapest
          </a>
          {hu ? ' (Belváros, Ferenciek tere közelében).' : ' (Belváros / city centre, near Ferenciek tere).'}
        </p>
        <div class="callout">
          <strong>{hu ? 'Kapcsolódó útmutató: ' : 'Related guide: '}</strong>
          <a href={model.guide[lang].url}>{model.guide[lang].name}</a>
        </div>
        {related.length > 0 && (
          <div class="model-related">
            <h2>{hu ? 'Hasonlítsa össze más modellekkel' : 'Compare with other models'}</h2>
            <ul>
              {related.map((other: any) => (
                <li>
                  <a href={`${hu ? '/modellek/' : '/en/models/'}${other.slug}/`}>{other.names[lang]}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
