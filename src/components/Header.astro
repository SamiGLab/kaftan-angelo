---
import Icon from './Icon.astro';
import { nav } from '../data/site';

const { lang = 'hu', counterpart = lang === 'hu' ? '/en/' : '/' } = Astro.props;
const hu = lang === 'hu';
const home = hu ? '/' : '/en/';
const fittingHref = hu ? '/kollekciok/#fitting-list' : '/en/collections/#fitting-list';
const route = Astro.url.pathname;
const collections = hu
  ? ['/kollekciok/', '/noi-borkabatok/', '/ferfi-borkabatok/', '/irhakabatok/', '/szormekabatok/']
  : ['/en/collections/', '/en/womens-leather-jackets/', '/en/mens-leather-jackets/', '/en/shearling-jackets/', '/en/fur-coats/'];
const deptItems: [string, string][] = hu
  ? [
      ['Női bőrkabátok', '/noi-borkabatok/'],
      ['Férfi bőrkabátok', '/ferfi-borkabatok/'],
      ['Irha', '/irhakabatok/'],
      ['Szőrme', '/szormekabatok/'],
    ]
  : [
      ['Women’s leather', '/en/womens-leather-jackets/'],
      ['Men’s leather', '/en/mens-leather-jackets/'],
      ['Shearling', '/en/shearling-jackets/'],
      ['Fur', '/en/fur-coats/'],
    ];
const items = [...nav[lang as 'hu' | 'en'], [hu ? 'GYIK' : 'FAQ', hu ? '/gyik/' : '/en/faq/']];
const active = (href: string) =>
  route === href || (href === collections[0] && collections.includes(route)) || (href !== home && route.startsWith(href));

---
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href={home} aria-label={hu ? 'Kaftan Angelo — főoldal' : 'Kaftan Angelo — home'}>Kaftan <span>Angelo</span></a>

    <button
      type="button"
      class="header-search-bar"
      data-global-search-open
      aria-label={hu ? 'Modell, szín vagy fazon keresése…' : 'Search models, colour or style…'}
    >
      <Icon name="search" />
      <span class="header-search-placeholder">
        {hu ? 'Modell, szín vagy fazon keresése…' : 'Search models, colour or style…'}
      </span>
      <kbd class="header-search-kbd" aria-hidden="true">Ctrl+K</kbd>
    </button>

    <div class="nav-tools">
      <a
        class="header-tool-btn header-fitting-btn"
        href={fittingHref}
        aria-label={hu ? 'Próbalistám' : 'My fitting list'}
        title={hu ? 'Próbalistám' : 'My fitting list'}
      >
        <span class="header-tool-heart" aria-hidden="true">♡</span>
        <span class="header-tool-badge" data-header-fitting-count hidden>0</span>
      </a>
      <a
        class="header-tool-btn header-wa-btn"
        href="https://wa.me/36203593216"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={hu ? 'WhatsApp üzenet' : 'WhatsApp message'}
        title="WhatsApp"
      >
        <Icon name="message" />
      </a>
      <nav class="language-choice" aria-label={hu ? 'Nyelvválasztás' : 'Language selection'}>
        {hu ? <span class="language-option" lang="hu" aria-current="true"><span class="language-full">Magyar</span><span class="language-short" aria-hidden="true">HU</span></span> : <a class="language-option" href={counterpart} lang="hu" hreflang="hu" rel="alternate" aria-label="HU — Az oldal magyarul"><span class="language-full">Magyar</span><span class="language-short" aria-hidden="true">HU</span></a>}
        {hu ? <a class="language-option" href={counterpart} lang="en" hreflang="en" rel="alternate" aria-label="EN — View this page in English"><span class="language-full">English</span><span class="language-short" aria-hidden="true">EN</span></a> : <span class="language-option" lang="en" aria-current="true"><span class="language-full">English</span><span class="language-short" aria-hidden="true">EN</span></span>}
      </nav>
      <button class="menu-toggle" type="button" aria-label={hu ? 'Menü' : 'Menu'} aria-expanded="false" aria-controls="primary-navigation"><Icon name="menu" class="menu-open-icon" /><Icon name="x" class="menu-close-icon" /><span>{hu ? 'Menü' : 'Menu'}</span></button>
    </div>

    <div class="mobile-menu-backdrop" data-menu-backdrop hidden></div>
    <nav id="primary-navigation" class="links" data-menu aria-label={hu ? 'Fő navigáció' : 'Primary navigation'}>
      <div class="mobile-drawer-head">
        <a class="brand" href={home}>Kaftan <span>Angelo</span></a>
        <button type="button" class="mobile-drawer-close" data-menu-close aria-label={hu ? 'Menü bezárása' : 'Close menu'}>
          <Icon name="x" />
        </button>
      </div>

      <div class="mobile-drawer-search-wrap">
        <button type="button" class="mobile-drawer-search" data-global-search-open data-drawer-search-btn>
          <Icon name="search" />
          <span>{hu ? 'Modell, szín vagy fazon keresése…' : 'Search models, colour or style…'}</span>
        </button>
      </div>

      <div class="desktop-nav-group">
        {deptItems.map(([label, href]) => (
          <a class="nav-dept-link" href={href} aria-current={route === href ? 'page' : undefined}>{label}</a>
        ))}
        <span class="nav-dept-sep" aria-hidden="true"></span>
        {items.map(([label, href]) => (
          href === collections[0] ? (
            <div class="nav-mega-wrap">
              <a class="nav-mega-trigger" href={href} aria-current={active(href) ? 'page' : undefined}>
                {label} <span class="nav-mega-caret" aria-hidden="true">▾</span>
              </a>
              <div class="nav-mega-panel">
                <div class="nav-mega-col">
                  <span class="nav-mega-kicker">{hu ? 'Kategóriák' : 'Categories'}</span>
                  <a href={collections[0]}>{hu ? 'Összes modell' : 'All models'}</a>
                  {deptItems.map(([dLabel, dHref]) => (
                    <a href={dHref}>{dLabel}</a>
                  ))}
                </div>
                <div class="nav-mega-col">
                  <span class="nav-mega-kicker">{hu ? 'Szolgáltatások' : 'Showroom'}</span>
                  <a href={hu ? '/egyedi-rendeles/' : '/en/custom-orders/'}>{hu ? 'Egyedi rendelés & méretre igazítás' : 'Custom orders & tailoring'}</a>
                  <a href={hu ? '/uzlet/' : '/en/visit/'}>{hu ? 'Budapesti üzlet · Kossuth Lajos u. 18' : 'Budapest store · Kossuth Lajos u. 18'}</a>
                  <a href={hu ? '/utmutatok/' : '/en/guides/'}>{hu ? 'Bőrkabát választási útmutatók' : 'Leather & shearling guides'}</a>
                </div>
              </div>
            </div>
          ) : (
            <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>
          )
        ))}
      </div>

      <div class="mobile-drawer-body">
        <details class="mobile-drawer-accordion" open={collections.includes(route)}>
          <summary>{hu ? 'Kollekciók' : 'Collections'}</summary>
          <div class="mobile-drawer-sub">
            <a href={collections[0]} aria-current={route === collections[0] ? 'page' : undefined}>{hu ? 'Összes kollekció' : 'All collections'}</a>
            {deptItems.map(([label, href]) => (
              <a href={href} aria-current={route === href ? 'page' : undefined}>{label}</a>
            ))}
          </div>
        </details>
        {items.filter(([, href]) => href !== collections[0]).map(([label, href]) => (
          <a class="mobile-drawer-link" href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>
        ))}
      </div>

      <div class="mobile-drawer-footer">
        <div class="mobile-drawer-lang" role="group" aria-label={hu ? 'Nyelvválasztás' : 'Language selection'}>
          {hu ? <span class="mobile-lang-pill is-active" lang="hu" aria-current="true">Magyar (HU)</span> : <a class="mobile-lang-pill" href={counterpart} lang="hu" hreflang="hu" rel="alternate">Magyar (HU)</a>}
          {hu ? <a class="mobile-lang-pill" href={counterpart} lang="en" hreflang="en" rel="alternate">English (EN)</a> : <span class="mobile-lang-pill is-active" lang="en" aria-current="true">English (EN)</span>}
        </div>
        <a class="mobile-drawer-store" href={hu ? '/uzlet/' : '/en/visit/'}>
          <Icon name="location" />
          <span>Kossuth Lajos u. 18 · Budapest</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
(() => {
  const badge = document.querySelector('[data-header-fitting-count]');
  const syncBadge = () => {
    if (!badge) return;
    try {
      const saved = JSON.parse(localStorage.getItem('kaftan_fitting_list_v1') || '[]');
      const count = Array.isArray(saved) ? saved.length : 0;
      badge.textContent = String(count);
      badge.hidden = count === 0;
    } catch {}
  };
  syncBadge();
  window.addEventListener('storage', syncBadge);
  window.addEventListener('kaftan-fitting-change', syncBadge);
})();
</script>


