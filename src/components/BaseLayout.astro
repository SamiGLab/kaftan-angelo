---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '@fontsource-variable/fraunces';

import '@fontsource-variable/work-sans';

import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import headingFont from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';
import labelFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import { BASE, businessSchema, websiteSchema } from '../data/site';
const { page } = Astro.props;
const lang = page.lang ?? 'hu';
const heroImage = page.mainHtml?.match(/--hero:url\('([^']+)'\)/)?.[1] ?? new URL(page.ogImage).pathname;
const mobileHero = heroImage.replace('-800.avif', '-480.avif');
const socialImage = page.ogImage.replace(/\/assets\/images\/(.+)-(480|800|1200)\.avif$/, '/$1.webp');
const huUrl = lang === 'hu' ? page.canonical : BASE + page.counterpart;
const enUrl = lang === 'en' ? page.canonical : BASE + page.counterpart;
const breadcrumbs = page.breadcrumbs ?? [];
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item:any, i:number) => ({ '@type':'ListItem', position:i+1, name:item.name, item: BASE + item.url })),
};
const pageSchema = { ...page.pageSchema, url: page.canonical, isPartOf: { '@id': `${BASE}/#website` }, about: { '@id': `${BASE}/#store` } };
const graph = { '@context':'https://schema.org', '@graph':[businessSchema, websiteSchema, pageSchema, breadcrumbSchema] };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add("js");</script>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-5D5T9W6Q');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{page.title}</title>
  <meta name="description" content={page.description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={page.canonical} />
  <link rel="alternate" hreflang="hu" href={huUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={huUrl} />
  <meta property="og:type" content={page.pageSchema?.['@type'] === 'Article' ? 'article' : 'website'} />
  <meta property="og:site_name" content="Kaftan Angelo" />
  <meta property="og:url" content={page.canonical} />
  <meta property="og:title" content={page.title} />
  <meta property="og:description" content={page.description} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={page.title} />
  <meta name="twitter:description" content={page.description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="theme-color" content="#1b120c" />
  <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin="anonymous" />
  <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin="anonymous" />
  <link rel="preload" as="font" type="font/woff2" href={labelFont} crossorigin="anonymous" />
  <link rel="preload" as="image" href={mobileHero} media="(max-width: 620px)" fetchpriority="high" />
  <link rel="preload" as="image" href={heroImage} media="(min-width: 621px)" fetchpriority="high" />
  <link rel="stylesheet" href="/assets/css/pages.css" />
  <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
  <slot name="head" />
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5D5T9W6Q" height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
  <a class="skip-link" href="#main-content">{lang === "hu" ? "Ugrás a tartalomhoz" : "Skip to content"}</a>
  <Header lang={lang} counterpart={page.counterpart} />
  <main id="main-content" tabindex="-1" data-pagefind-body><slot /></main>
  <Footer lang={lang} />
  {page.mainHtml?.includes('data-product-image') && <dialog class="product-dialog" data-product-dialog aria-labelledby="product-preview-title">
    <div class="preview-header"><h2 id="product-preview-title" data-preview-title>{lang === 'hu' ? 'Modell' : 'Model'}</h2><button class="preview-close" type="button" data-preview-close aria-label={lang === 'hu' ? 'Bezárás' : 'Close'}>×</button></div>
    <div class="preview-body"><img data-preview-image src={heroImage} alt="" width="900" height="900" loading="lazy" /><div class="preview-details"><p>{lang === 'hu' ? 'Az aktuális méretekről és elérhetőségről érdeklődjön közvetlenül az üzletben. A kabátokat személyesen próbálhatja fel.' : 'Ask our store about available sizes and current availability. Visit us to try the jackets on in person.'}</p><a class="btn btn-primary" data-preview-inquiry href="https://wa.me/36203593216">{lang === 'hu' ? 'Érdeklődés WhatsAppon' : 'Ask on WhatsApp'}</a><div class="preview-controls"><button type="button" data-preview-prev aria-label={lang === 'hu' ? 'Előző modell' : 'Previous model'}>←</button><span data-preview-count></span><button type="button" data-preview-next aria-label={lang === 'hu' ? 'Következő modell' : 'Next model'}>→</button></div></div></div>
  </dialog>}
  <script is:inline defer src="/assets/js/pages.js"></script>
  <slot name="scripts" />
</body>
</html>
