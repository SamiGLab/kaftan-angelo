---
import Icon from './Icon.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AnalyticsConsent from './AnalyticsConsent.astro';
import WhatsAppButton from './WhatsAppButton.astro';

const headingFont = '/assets/fonts/fraunces-latin-wght-normal.woff2';
const headingExtendedFont = '/assets/fonts/fraunces-hungarian-wght-normal.woff2';
import { BASE, businessSchema, websiteSchema } from '../data/site';
const { page } = Astro.props;
const lang = page.lang ?? 'hu';
const isPartnerPortal = ['/partner-portal/', '/en/partner-portal/'].includes(new URL(page.canonical).pathname);
const isModelPage = Boolean(page.isModel || page.mainHtml?.includes('class="model-detail"'));
const preloadHero = !isModelPage;
const heroImage = page.mainHtml?.match(/--hero:\s*url\('([^']+)'\)/)?.[1] ?? new URL(page.ogImage).pathname;
const heroMobileImage = page.mainHtml?.match(/--hero-mobile:\s*url\('([^']+)'\)/)?.[1]
  // Guides render their hero outside page.mainHtml. Match the mobile asset used
  // by the hero CSS rather than preloading the desktop-sized 800px version.
  ?? (!isModelPage && page.ogImage?.endsWith('-800.avif')
    ? new URL(page.ogImage.replace(/-800\.avif$/, '-480.avif')).pathname
    : undefined);
import { backgroundImage } from './responsive-images';
const sharpHero = backgroundImage(heroImage, page.mainHtml?.includes('class="home-hero"') ? 1600 : 1200);
const heroCandidates = [...sharpHero.matchAll(/url\('([^']+)'\) (\d)x/g)];
const modelAvifSource = isModelPage ? (page.mainHtml?.match(/<source\s+[^>]*type="image\/avif"[^>]*>/i) || page.mainHtml?.match(/<source\s+[^>]*srcset="[^"]+\.avif[^"]*"[^>]*>/i))?.[0] : null;
const modelAvifSrcset = modelAvifSource ? modelAvifSource.match(/srcset="([^"]+)"/)?.[1] : null;
const modelAvifSizes = modelAvifSource ? modelAvifSource.match(/sizes="([^"]+)"/)?.[1] : null;
const socialImage = page.ogImage.replace(/\/assets\/images\/(.+)-(480|800|1200)\.avif$/, '/$1.webp');
const huUrl = lang === 'hu' ? page.canonical : BASE + page.counterpart;
const enUrl = lang === 'en' ? page.canonical : BASE + page.counterpart;
const breadcrumbs = page.breadcrumbs ?? [];
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item:any, i:number) => ({ '@type':'ListItem', position:i+1, name:item.name, item: BASE + item.url })),
};
const extraSchemas = [page.productSchema, page.faqSchema].filter(Boolean);
const pageSchema = { ...page.pageSchema, url: page.canonical, isPartOf: { '@id': `${BASE}/#website` }, about: { '@id': `${BASE}/#store` } };
const graph = { '@context':'https://schema.org', '@graph':[businessSchema, websiteSchema, pageSchema, breadcrumbSchema, ...extraSchemas] };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add("js");</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{page.title}</title>
  <meta name="application-name" content="Kaftan Angelo" />
  <meta name="apple-mobile-web-app-title" content="Kaftan Angelo" />
  <meta name="description" content={page.description} />
  <meta name="robots" content={isPartnerPortal ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
  <link rel="canonical" href={page.canonical} />
  <link rel="alternate" hreflang="hu" href={huUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={huUrl} />
  <meta name="geo.region" content="HU-BU" />
  <meta name="geo.placename" content="Budapest" />
  <meta name="geo.position" content="47.4940457;19.0584288" />
  <meta name="ICBM" content="47.4940457, 19.0584288" />
  <meta name="format-detection" content="telephone=no" />
  <meta property="og:type" content={page.pageSchema?.['@type'] === 'Article' ? 'article' : 'website'} />
  <meta property="og:site_name" content="Kaftan Angelo" />
  <meta property="og:url" content={page.canonical} />
  <meta property="og:title" content={page.title} />
  <meta property="og:description" content={page.description} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:secure_url" content={socialImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="800" />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:alt" content={page.title} />
  <meta property="og:locale" content={lang === 'hu' ? 'hu_HU' : 'en_GB'} />
  <meta property="og:locale:alternate" content={lang === 'hu' ? 'en_GB' : 'hu_HU'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={page.title} />
  <meta name="twitter:description" content={page.description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="theme-color" content="#1b120c" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="help" type="text/plain" href="/llms.txt" title="LLM context" />
  <link rel="service-desc" type="application/ai-catalog+json" href="/.well-known/ai-catalog.json" title="AI Agent Resource Discovery" />
  <link rel="dns-prefetch" href="https://wa.me" />
  <link rel="preconnect" href="https://wa.me" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin="anonymous" />
  {lang === 'hu' && <link rel="preload" as="font" type="font/woff2" href={headingExtendedFont} crossorigin="anonymous" />}
  {preloadHero && <link rel="preload" as="image" href={heroMobileImage ?? heroCandidates[0]?.[1] ?? heroImage} media="(max-width: 620px)" fetchpriority="high" />}
  {preloadHero && <link rel="preload" as="image" href={heroImage} media="(min-width: 621px)" fetchpriority="high" />}
  {isModelPage && modelAvifSrcset && <link rel="preload" as="image" type="image/avif" imagesrcset={modelAvifSrcset} imagesizes={modelAvifSizes || '(max-width: 760px) 92vw, 600px'} fetchpriority="high" />}
  <link rel="preload" as="style" href="/assets/css/pages.css" />
  <link rel="stylesheet" href="/assets/css/pages.css" />
  <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main-content">{lang === "hu" ? "Ugrás a tartalomhoz" : "Skip to content"}</a>
  <Header lang={lang} counterpart={page.counterpart} />
  <main id="main-content" tabindex="-1" data-pagefind-body style={`--hero-sharp:${sharpHero}`}><slot /></main>
  <Footer lang={lang} trackingAllowed={!page.canonical.includes('/partner-portal/')} />
  {!page.canonical.includes('/partner-portal/') && <AnalyticsConsent lang={lang} />}
  {page.mainHtml?.includes('data-map-panel') && <script is:inline defer src="/assets/js/privacy-settings.js"></script>}
  <WhatsAppButton lang={lang} pageTitle={page.title} canonicalUrl={page.canonical} />
  {page.mainHtml?.includes('data-product-image') && <dialog class="product-dialog" data-product-dialog aria-labelledby="product-preview-title">
    <div class="preview-header"><h2 id="product-preview-title" data-preview-title>{lang === 'hu' ? 'Modell' : 'Model'}</h2><button class="preview-close" type="button" data-preview-close aria-label={lang === 'hu' ? 'Bezárás' : 'Close'}><Icon name="x" /></button></div>
    <div class="preview-body"><img data-preview-image src={heroImage} alt="" width="900" height="900" loading="lazy" /><div class="preview-details"><p>{lang === 'hu' ? 'Az aktuális méretekről és elérhetőségről érdeklődjön közvetlenül az üzletben. A kabátokat személyesen próbálhatja fel.' : 'Ask our store about available sizes and current availability. Visit us to try the jackets on in person.'}</p><a class="btn btn-primary" data-preview-inquiry href="https://wa.me/36203593216">{lang === 'hu' ? 'Érdeklődés WhatsAppon' : 'Ask on WhatsApp'}</a><div class="preview-controls"><button type="button" data-preview-prev aria-label={lang === 'hu' ? 'Előző modell' : 'Previous model'}><Icon name="previous" /></button><span data-preview-count></span><button type="button" data-preview-next aria-label={lang === 'hu' ? 'Következő modell' : 'Next model'}><Icon name="next" /></button></div></div></div>
  </dialog>}
  <script is:inline defer src="/assets/js/pages.js"></script>
  {page.mainHtml?.includes('data-partner-form') && <script is:inline defer src="/assets/js/partner-intake-client.js"></script>}
  <script is:inline>
    // WebMCP (Web Model Context Protocol) agent tools registration
    if (typeof document !== 'undefined' && 'modelContext' in document) {
      try {
        document.modelContext.registerTool({
          name: 'getBoutiqueDetails',
          description: 'Get Kaftan Angelo boutique address, opening hours, contact phone, and WhatsApp in central Budapest',
          inputSchema: { type: 'object', properties: {} },
          execute: async () => ({
            name: 'Kaftan Angelo',
            address: '1053 Budapest, Kossuth Lajos utca 18, Hungary',
            landmarks: 'Between Astoria (M2) and Ferenciek tere (M3), on Kossuth Lajos utca; walking routes from Váci utca and Deák Ferenc tér are available on the visit page',
            phone: '+36 1 266 7274',
            whatsapp: '+36 20 359 3216',
            openingHours: 'Mon-Fri 10:00-19:00, Sat 10:00-17:00, Sun Closed',
            products: 'Genuine lambskin & cowhide leather jackets, shearling coats, fur garments, made-to-measure tailoring'
          })
        });
      } catch (e) {}
    }
  </script>
  <slot name="scripts" />
</body>
</html>
