---
import Icon from './Icon.astro';
import { businessSchema } from '../data/site';

interface Props {
  lang: 'hu' | 'en';
}

const { lang } = Astro.props;
const en = lang === 'en';
---

<section class="trust-heritage" aria-labelledby="trust-heading">
  <div class="wrap">
    <div class="trust-badge-row">
      <span class="trust-badge">
        <Icon name="award" />
        <span>{en ? 'In Budapest Since 2004 · 20+ Years Heritage' : '2004 óta Budapest szívében · 20+ év szakértelem'}</span>
      </span>
      <span class="trust-badge">
        <Icon name="shield" />
        <span>{en ? '100% Genuine Leather & Shearling' : '100% valódi bőr és irha minőség'}</span>
      </span>
      <span class="trust-badge">
        <Icon name="star" class="star-gold" />
        <span>{en ? '5.0★ Rating on Google' : '5.0★ értékelés a Google-on'}</span>
      </span>
    </div>

    <div class="trust-header">
      <span class="tag mono">{en ? 'Heritage & Satisfaction' : 'Hagyomány és Bizalom'}</span>
      <h2 id="trust-heading">{en ? '20 years of trusted leather expertise in Budapest' : '20 év tapasztalat és szakértelem Budapest szívében'}</h2>
      <p>{en ? 'Welcoming international visitors, expats and Budapest residents since 2004 with personalized fitting and premium genuine outerwear.' : 'A Kaftan Angelo 2004 óta áll a hazai és külföldi vásárlók szolgálatában a Kossuth Lajos utcai bemutatóteremben, prémium minőségű bőrkabátokkal és méretre igazítással.'}</p>
    </div>

    <ul class="trust-grid">
      <li class="trust-card">
        <a class="rating-row" data-google-profile href={businessSchema.hasMap} target="_blank" rel="noopener noreferrer">
          <Icon name="star" />
          <span>{en ? '5.0★ Google Business Profile' : '5.0★ Google Cégprofil'} <span aria-hidden="true">↗</span></span>
        </a>
        <h3><Icon name="badge" /> <span>{en ? '5.0 Google satisfaction' : '5.0 Google értékelések'}</span></h3>
        <p>{en ? 'Verified 5.0 rating on Google Maps: genuine quality, welcoming showroom hospitality and expert fitting in Budapest.' : 'Kiváló 5.0 értékelés a Google Térképen: prémium minőség, barátságos kiszolgálás és szakértő méretre igazítás Budapesten.'}</p>
      </li>

      <li class="trust-card">
        <h3><Icon name="scissors" /> <span>{en ? 'Expert personal sizing' : 'Személyre szabott méretre igazítás'}</span></h3>
        <p>{en ? 'Every jacket can be fitted and adjusted to your exact measurements. Experience personal fitting directly in our private dressing rooms.' : 'A kiválasztott fazont kényelmes próbafülkénkben felpróbálhatja, és igény esetén méretre igazítjuk vagy egyedi méretben elkészítjük.'}</p>
        <ul class="trust-perks">
          <li><Icon name="check" /> {en ? 'Sleeve and waist adjustments' : 'Ujjhossz és derékbőség igazítása'}</li>
          <li><Icon name="check" /> {en ? 'Custom sizing orders available' : 'Egyedi rendelési és méret opciók'}</li>
        </ul>
      </li>

      <li class="trust-card">
        <h3><Icon name="store" /> <span>{en ? 'Central Belváros showroom' : 'Belvárosi állandó bemutatóterem'}</span></h3>
        <p>{en ? 'Permanent showroom on Kossuth Lajos utca for two decades. Enjoy reliable aftercare, advice and transparent service without rush.' : 'Két évtizede stabil pont az V. kerületben. Nyugodt próbalehetőség és megbízható garancia a vásárlás után is.'}</p>
        <ul class="trust-perks">
          <li><Icon name="check" /> {en ? 'Walk-ins welcome without booking' : 'Időpontfoglalás nélkül is látogatható'}</li>
          <li><Icon name="check" /> {en ? 'Card & cash payments accepted' : 'Bankkártyás és készpénzes fizetés'}</li>
        </ul>
      </li>
    </ul>
  </div>
</section>

<style>
  .trust-heritage {
    border-bottom: 1px solid var(--line, #d8c9b5);
    padding: 3.5rem 0;
  }
  .trust-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #dcb27c14;
    border: 1px solid #dcb27c4d;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--bright, #dcb27c);
  }
  .trust-badge :global(.ui-icon) {
    color: var(--bright, #dcb27c);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .trust-badge :global(.star-gold) {
    fill: #f59e0b;
    color: #f59e0b;
  }
  .trust-header h2 {
    margin: 0.5rem 0 0.75rem;
  }
  .trust-header p {
    color: var(--dim, #c9bba5);
    max-width: 65ch;
    margin-bottom: 2rem;
  }
  .trust-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .trust-card {
    background: var(--bg2, #241a12);
    border: 1px solid #dcb27c2e;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .trust-card:hover {
    border-color: var(--bright, #dcb27c);
    transform: translateY(-2px);
  }
  .rating-row {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    color: var(--bright, #dcb27c);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .rating-row :global(.ui-icon) {
    flex: 0 0 auto;
    width: 17px;
    height: 17px;
  }
  .rating-row:focus-visible {
    outline: 2px solid var(--bright, #dcb27c);
    outline-offset: 4px;
  }
  .trust-card h3 {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.35;
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
    color: var(--cream, #efe4d2);
  }
  .trust-card h3 :global(.ui-icon) {
    color: var(--bright, #dcb27c);
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
  }
  .trust-card h3 span {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .trust-card p {
    color: var(--dim, #c9bba5);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }
  .trust-perks {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .trust-perks li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--dim, #c9bba5);
  }
  .trust-perks li :global(.ui-icon) {
    color: var(--bright, #dcb27c);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 3px;
  }
  @media (max-width: 980px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .trust-heritage {
      padding: 2.5rem 0;
    }
    .trust-grid {
      grid-template-columns: 1fr;
    }
    .trust-card {
      padding: 1.25rem;
    }
  }
</style>
