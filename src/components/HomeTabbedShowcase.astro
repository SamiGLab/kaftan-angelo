---
import models from '../data/models.json';

interface Props {
  lang: 'hu' | 'en';
}

const { lang } = Astro.props;
const hu = lang === 'hu';

const visible = models.filter((m) => !m.catalogHidden);
const women = visible.filter((m) => m.category.hu.url === '/noi-borkabatok/');
const men = visible.filter((m) => m.category.hu.url === '/ferfi-borkabatok/');
const shearlingAndFur = visible.filter(
  (m) => m.category.hu.url === '/irhakabatok/' || m.category.hu.url === '/szormekabatok/'
);

const featured = [
  women[0],
  men[0],
  shearlingAndFur[0],
  women[1],
].filter(Boolean);

const tabs = [
  { id: 'featured', label: hu ? 'Kiemelt modellek' : 'Featured', items: featured },
  { id: 'women', label: hu ? 'Női bőrkabátok' : 'Women’s leather', items: women.slice(0, 4) },
  { id: 'men', label: hu ? 'Férfi bőrkabátok' : 'Men’s leather', items: men.slice(0, 4) },
  { id: 'winter', label: hu ? 'Irha & szőrme' : 'Shearling & fur', items: shearlingAndFur.slice(0, 4) },
];

const toAvif = (img: string) => '/assets/images/' + img.replace(/^\//, '').replace(/\.webp$/, '-480.avif');
const toWebp = (img: string) => '/assets/images/' + img.replace(/^\//, '').replace(/\.webp$/, '-480.webp');
const modelUrl = (m: (typeof visible)[number]) =>
  hu ? `/modellek/${m.slugs.hu}/` : `/en/models/${m.slugs.en}/`;
---

<section class="home-showcase" aria-labelledby="home-showcase-heading" data-home-showcase>
  <div class="wrap">
    <div class="showcase-head">
      <div>
        <span class="tag mono">{hu ? 'Válogatás a bemutatóteremből' : 'Showroom selection'}</span>
        <h2 id="home-showcase-heading">{hu ? 'Kiemelt kollekciók' : 'Featured pieces'}</h2>
      </div>
      <div class="showcase-tabs" role="tablist" aria-label={hu ? 'Kollekció fülek' : 'Collection tabs'}>
        {tabs.map((tab, idx) => (
          <button
            type="button"
            role="tab"
            id={`showcase-tab-${tab.id}`}
            aria-controls={`showcase-panel-${tab.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            class={`showcase-tab${idx === 0 ? ' is-active' : ''}`}
            data-showcase-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    {tabs.map((tab, idx) => (
      <div
        id={`showcase-panel-${tab.id}`}
        role="tabpanel"
        aria-labelledby={`showcase-tab-${tab.id}`}
        class="showcase-panel"
        data-showcase-panel={tab.id}
        hidden={idx !== 0}
      >
        <div class="showcase-grid">
          {tab.items.map((m) => (
            <article class="showcase-card">
              <div class="showcase-media">
                <a href={modelUrl(m)} class="showcase-photo-link">
                  <picture>
                    <source srcset={toAvif(m.image)} type="image/avif" />
                    <source srcset={toWebp(m.image)} type="image/webp" />
                    <img
                      src={m.image}
                      alt={m.names[lang]}
                      width="480"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </a>
                <button
                  type="button"
                  class="showcase-save"
                  data-showcase-save={m.slug}
                  aria-pressed="false"
                  aria-label={(hu ? 'Mentés a próbalistára: ' : 'Save to fitting list: ') + m.names[lang]}
                >
                  ♡
                </button>
              </div>
              <div class="showcase-body">
                <span class="showcase-cat">{m.category[lang].name}</span>
                <h3>
                  <a href={modelUrl(m)}>{m.names[lang]}</a>
                </h3>
                {(m as { material?: Record<string, string> }).material?.[lang] && (
                  <p class="showcase-mat">{(m as { material?: Record<string, string> }).material?.[lang]}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

    <div class="showcase-cta">
      <a class="btn btn-ghost" href={hu ? '/kollekciok/' : '/en/collections/'}>
        {hu ? `Összes modell megtekintése (${visible.length})` : `Browse all ${visible.length} models`} →
      </a>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const root = document.querySelector('[data-home-showcase]');
  if (!root) return;

  const tabs = Array.from(root.querySelectorAll('[data-showcase-tab]'));
  const panels = Array.from(root.querySelectorAll('[data-showcase-panel]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-showcase-tab');
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((p) => {
        p.hidden = p.getAttribute('data-showcase-panel') !== target;
      });
    });
  });

  const FITTING_LIST_ID = 'kaftan_fitting_list_v1';
  const LIMIT = 12;
  const readList = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(FITTING_LIST_ID) || '[]');
      return new Set(Array.isArray(parsed) ? parsed.slice(0, LIMIT) : []);
    } catch {
      return new Set();
    }
  };
  const syncButtons = () => {
    const list = readList();
    root.querySelectorAll('[data-showcase-save]').forEach((btn) => {
      const key = btn.getAttribute('data-showcase-save');
      const saved = key ? list.has(key) : false;
      btn.setAttribute('aria-pressed', saved ? 'true' : 'false');
      btn.textContent = saved ? '♥' : '♡';
    });
  };
  root.querySelectorAll('[data-showcase-save]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-showcase-save');
      if (!key) return;
      const list = readList();
      if (list.has(key)) list.delete(key);
      else if (list.size < LIMIT) list.add(key);
      try {
        localStorage.setItem(FITTING_LIST_ID, JSON.stringify([...list]));
      } catch {}
      window.dispatchEvent(new Event('kaftan-fitting-change'));
      syncButtons();
    });
  });
  window.addEventListener('kaftan-fitting-change', syncButtons);
  syncButtons();
})();
</script>

<style>
  .home-showcase {
    padding: 3rem 0;
    border-bottom: 1px solid #efe4d229;
    background: #1b120c;
    color: #efe4d2;
  }
  .showcase-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .showcase-head .tag {
    color: #dcb27c;
  }
  .showcase-head h2 {
    margin: 0.35rem 0 0;
    color: #efe4d2;
  }
  .showcase-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border-bottom: 1px solid #efe4d229;
  }
  .showcase-tab {
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    color: #d4c6b2;
    padding: 0.55rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    margin-bottom: -1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .showcase-tab:hover {
    color: #efe4d2;
  }
  .showcase-tab.is-active {
    color: #dcb27c;
    border-bottom-color: #dcb27c;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.15rem;
  }
  .showcase-card {
    background: #241a12;
    border: 1px solid #dcb27c2e;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .showcase-card:hover {
    border-color: var(--bright, #dcb27c);
    transform: translateY(-2px);
  }
  .showcase-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--product-surface, #e8e5df);
    overflow: hidden;
  }
  .showcase-photo-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .showcase-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .showcase-save {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid #dcb27c66;
    background: rgba(27, 18, 12, 0.82);
    color: var(--cream, #efe4d2);
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .showcase-save[aria-pressed="true"] {
    color: var(--bright, #dcb27c);
    border-color: var(--bright, #dcb27c);
  }
  .showcase-body {
    padding: 0.9rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .showcase-cat {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #dcb27c;
  }
  .showcase-body h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
  }
  .showcase-body h3 a {
    color: #efe4d2;
    text-decoration: none;
  }
  .showcase-body h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .showcase-mat {
    margin: 0.1rem 0 0;
    font-size: 0.8rem;
    color: #d4c6b2;
  }
  .showcase-cta {
    margin-top: 1.75rem;
    text-align: center;
  }

  @media (max-width: 980px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .home-showcase {
      padding: 2.25rem 0;
    }
    .showcase-grid {
      gap: 0.75rem;
    }
    .showcase-body {
      padding: 0.75rem;
    }
  }
</style>
