---
import { withIcons } from '../components/icon';
import { responsiveImages } from '../components/responsive-images';
import BaseLayout from '../components/BaseLayout.astro';
import ModelDetail from '../components/ModelDetail.astro';
import LandmarksGrid from '../components/LandmarksGrid.astro';
import TrustHeritage from '../components/TrustHeritage.astro';
import { landmarkPages, landmarkMarker, locationFaq, heroWalkLabel, type LandmarkLanguage } from '../data/landmarks';
import pages from '../data/pages.json';
import { modelPages } from '../data/model-pages';
export function getStaticPaths() {
  return Object.entries({ ...pages, ...modelPages })
    .filter(([path]) => path !== '/' && !path.startsWith('/utmutatok/') && !path.startsWith('/en/guides/'))
    .map(([path, page]) => ({ params: { slug: path.replace(/^\//,'').replace(/\/$/,'') }, props: { page } }));
}
const { page: sourcePage } = Astro.props as { page: any };
const hasLandmarks = landmarkPages.includes(sourcePage.path);
const fullLandmarks = ['/en/visit/', '/uzlet/'].includes(sourcePage.path);
const lang = sourcePage.lang as LandmarkLanguage;
const faq = locationFaq(lang);
const page = hasLandmarks && !fullLandmarks ? {
  ...sourcePage,
  faqSchema: {
    '@type': 'FAQPage',
    mainEntity: [...(sourcePage.faqSchema?.mainEntity ?? []), {
      '@type': 'Question', name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    }],
  },
} : sourcePage;
const sections = hasLandmarks ? page.mainHtml.replace('<!-- store-landmark-pill -->', heroWalkLabel(lang)).split(landmarkMarker) : [];
if (hasLandmarks && sections.length !== 2) throw new Error(`Expected one landmark placement marker: ${page.path}`);
// The English homepage shares the TrustHeritage cards with the Hungarian homepage.
// Split only at a complete section boundary, never inside the neighbouring split-grid.
const englishHome = page.path === '/en/';
const homeMarker = '<section class="split-section">';
const homeParts = englishHome ? page.mainHtml.split(homeMarker) : [];
if (englishHome && homeParts.length !== 2) throw new Error('Expected one English homepage trust placement marker');
---
<BaseLayout page={page}>
  {page.isModel ? (
    <ModelDetail page={page} />
  ) : hasLandmarks ? (
    <Fragment set:html={withIcons(responsiveImages(sections[0]))} />
    <TrustHeritage lang={lang} />
    <LandmarksGrid lang={lang} full={fullLandmarks} />
    <Fragment set:html={withIcons(responsiveImages(sections[1]))} />
  ) : englishHome ? (
    <>
      <Fragment set:html={withIcons(responsiveImages(homeParts[0]))} />
      <TrustHeritage lang="en" />
      <Fragment set:html={withIcons(responsiveImages(homeMarker + homeParts[1]))} />
    </>
  ) : (
    <Fragment set:html={withIcons(responsiveImages(page.mainHtml))} />
  )}
</BaseLayout>
