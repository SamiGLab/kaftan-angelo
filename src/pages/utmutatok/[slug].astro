---
import GuideArticle from '../../components/GuideArticle.astro';
export function getStaticPaths() {
 const modules = import.meta.glob('../../content/guides/hu/*.md', { eager: true });
 return Object.entries(modules).map(([path, mod]) => { const slug = path.split('/').pop().replace('.md',''); return { params:{slug}, props:{mod, slug} }; });
}
const { mod, slug } = Astro.props;
---
<GuideArticle mod={mod} slug={slug} lang="hu" />
