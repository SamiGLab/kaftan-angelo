---
import models from '../../../data/models.json';
import { BASE } from '../../../data/site';

export function getStaticPaths() {
  return models
    .filter(model => model.slug !== model.slugs.en)
    .map(model => ({
      params: { legacy: model.slug },
      props: {
        target: `/en/models/${model.slugs.en}/`,
        name: model.names.en,
      },
    }));
}

const { target, name } = Astro.props as { target: string; name: string };
const canonical = `${BASE}${target}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{name}</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={canonical} />
  <script is:inline define:vars={{ target }}>
    location.replace(target + location.search + location.hash);
  </script>
</head>
<body>
  <main>
    <h1>{name}</h1>
    <p>This page has moved to a localized English URL: <a href={target}>{canonical}</a>.</p>
  </main>
</body>
</html>
