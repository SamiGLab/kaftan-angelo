---
import type { GuideModule } from '../../../data/guide-types';
import BaseLayout from '../../../components/BaseLayout.astro';
const modules = import.meta.glob<GuideModule>('../../../content/guides/en/*.md', { eager: true });
const guides = Object.entries(modules).map(([path, mod]) => ({
  slug: path.split('/').pop()!.replace('.md', ''),
  ...mod.frontmatter
})).sort((a, b) => b.publishDate.localeCompare(a.publishDate));

const mainEntity = {
  '@type': 'ItemList',
  numberOfItems: guides.length,
  itemListElement: guides.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.title,
    url: `https://kaftanangelo.com/en/guides/${g.slug}/`
  }))
};

const page = {
  lang: 'en',
  title: 'Leather, Shearling & Fur Guides | Kaftan Angelo Budapest',
  description: 'Expert guides to choosing, fitting, shopping and caring for genuine leather, shearling and fur coats in Budapest.',
  canonical: 'https://kaftanangelo.com/en/guides/',
  counterpart: '/utmutatok/',
  ogImage: 'https://kaftanangelo.com/assets/images/kaftan-angelo-leather-jackets-budapest-800.avif',
  breadcrumbs: [{ name: 'Home', url: '/en/' }, { name: 'Guides', url: '/en/guides/' }],
  pageSchema: {
    '@type': 'CollectionPage',
    '@id': 'https://kaftanangelo.com/en/guides/#collection',
    name: 'Leather, Shearling & Fur Guides | Kaftan Angelo',
    description: 'Comprehensive guides to leather, shearling and fur outerwear in Budapest: selection, fitting, and long-term care.',
    mainEntity
  }
};
---
<BaseLayout page={page}>
  <section class="page-hero" style="--hero:url('/assets/images/kaftan-angelo-leather-jackets-budapest-800.avif');--hero-mobile:url('/assets/images/kaftan-angelo-leather-jackets-budapest-480.avif')">
    <div class="wrap">
      <div class="breadcrumbs"><a href="/en/">Home</a> / Guides</div>
      <span class="tag mono">Knowledge Base &amp; Buying Advice</span>
      <h1>Leather, Shearling &amp; Fur Guides</h1>
      <p>Angelo began working with leather in Istanbul in 1973; the Budapest store opened in 2004 at Kossuth Lajos u. 18. Our guides offer checks for comparing collections, preparing for an in-store fitting and asking about the care of a particular garment.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Featured Topics</h2>
        </div>
        <p>Explore essential topics or browse the complete library below.</p>
      </div>
      <div class="guide-list">
        <article class="guide-card">
          <span class="tag mono">Material Science</span>
          <h3><a href="/en/guides/leather-shearling-fur-comparison/">Leather, Shearling or Fur?</a></h3>
          <p>Compare coverage, weight, freedom of movement and garment-specific care before an in-store fitting.</p>
          <a href="/en/guides/leather-shearling-fur-comparison/">Read comparison →</a>
        </article>
        <article class="guide-card">
          <span class="tag mono">Budapest Shopping</span>
          <h3><a href="/en/guides/budapest-leather-shopping-guide/">Budapest Leather Shopping Guide</a></h3>
          <p>Step-by-step guidance from choosing styles online to a relaxed in-store fitting at Kossuth Lajos u. 18 in central Budapest.</p>
          <a href="/en/guides/budapest-leather-shopping-guide/">Explore shopping guide →</a>
        </article>
        <article class="guide-card">
          <span class="tag mono">Quality Inspection</span>
          <h3><a href="/en/guides/second-hand-leather-jacket-checklist/">Second-Hand Leather Checklist</a></h3>
          <p>Read the material label, inspect lining and closures, and identify condition and repair questions to discuss with a specialist.</p>
          <a href="/en/guides/second-hand-leather-jacket-checklist/">View checklist →</a>
        </article>
        <article class="guide-card">
          <span class="tag mono">Fit &amp; Sizing</span>
          <h3><a href="/en/guides/leather-jacket-fit-guide/">Leather Jacket Fit Guide</a></h3>
          <p>Fit checks for shoulder movement, sleeve length and room for seasonal layers.</p>
          <a href="/en/guides/leather-jacket-fit-guide/">Read fit tips →</a>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Featured Model Spotlight</h2>
        </div>
        <p>Compare the cut, photographs and fit of one selected model.</p>
      </div>
      <div class="callout">
        <h3><a href="/en/models/siyah-kapitone-budapest/">Black Quilted Men’s Leather Jacket</a></h3>
        <p>A quilted men’s leather jacket shown in front and back photographs. Ask the store to confirm the exact material, size and availability; check the shoulders, sleeve length and movement during a fitting.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/en/models/siyah-kapitone-budapest/">View model details &amp; photos</a>
          <a class="btn btn-ghost" href="/en/mens-leather-jackets/">All men's leather jackets</a>
        </div>
      </div>
    </div>
  </section>

  <section class="guide-search-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Search the Knowledge Base</h2>
        </div>
        <p>Search by keywords, materials, or practical care advice across all guides.</p>
      </div>
      <div id="guide-search"></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>All Guides &amp; Articles</h2>
        </div>
        <p>Browse our complete library ordered by topic and reading time.</p>
      </div>
      <div class="guide-list">
        {guides.map(g => (
          <article class="guide-card">
            <span class="tag mono">{g.topic}</span>
            <h2><a href={`/en/guides/${g.slug}/`}>{g.title}</a></h2>
            <p>{g.description}</p>
            <p class="guide-meta">{g.readingMinutes} min read</p>
            <a href={`/en/guides/${g.slug}/`}>Read guide →</a>
          </article>
        ))}
      </div>
      <div class="actions" style="margin-top: 2rem;">
        <a class="btn btn-primary" href="/en/collections/">Explore the collections</a>
        <a class="btn btn-ghost" href="/en/visit/">Directions &amp; opening hours</a>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
      window.addEventListener('load', () => {
        const startSearch = () => {
          const style = document.createElement('link');
          style.rel = 'stylesheet';
          style.href = '/pagefind/pagefind-ui.css';
          document.head.append(style);
          const script = document.createElement('script');
          script.src = '/pagefind/pagefind-ui.js';
          script.onload = () => new PagefindUI({ element: '#guide-search', showSubResults: true, showImages: false });
          document.body.append(script);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(startSearch);
        else setTimeout(startSearch, 0);
      });
    </script>
  </Fragment>
</BaseLayout>
