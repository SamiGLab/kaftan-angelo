---
import BaseLayout from '../../../components/BaseLayout.astro';
const modules = import.meta.glob('../../../content/guides/en/*.md', { eager:true });
const guides = Object.entries(modules).map(([path, mod])=>({slug:path.split('/').pop().replace('.md',''),...mod.frontmatter})).sort((a,b)=>b.publishDate.localeCompare(a.publishDate));
const page={lang:'en',title:'Leather, Shearling & Fur Guides | Kaftan Angelo Budapest',description:'Guides to leather, shearling and fur care, fit, material choice and shopping in Budapest.',canonical:'https://kaftanangelo.com/en/guides/',counterpart:'/utmutatok/',ogImage:'https://kaftanangelo.com/assets/images/kaftan-angelo-leather-jackets-budapest-800.avif',breadcrumbs:[{name:'Home',url:'/en/'},{name:'Guides',url:'/en/guides/'}],pageSchema:{'@type':'CollectionPage',name:'Leather, Shearling & Fur Guides'}};
page.pageSchema.mainEntity = { '@type': 'ItemList', itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.title, url: `https://kaftanangelo.com/en/guides/${g.slug}/` })) };
---
<BaseLayout page={page}>
<section class="page-hero" style="--hero:url('/assets/images/kaftan-angelo-leather-jackets-budapest-800.avif');--hero-mobile:url('/assets/images/kaftan-angelo-leather-jackets-budapest-480.avif')"><div class="wrap"><div class="breadcrumbs"><a href="/en/">Home</a> / Guides</div><span class="tag mono">Knowledge Base</span><h1>Leather, Shearling &amp; Fur Guides</h1><p>Choose, fit and care for leather, shearling and fur. Clear answers, practical checklists and help planning a Budapest store visit.</p></div></section>
<section><div class="wrap"><div class="section-head"><div><h2>Looking for a coat? Start here.</h2></div><p>Choose a material and cut, explore the collection, then ask about availability before coming in to try it on.</p></div><div class="guide-list"><article class="guide-card"><h3><a href="/en/guides/leather-shearling-fur-comparison/">Compare materials</a></h3><p>Leather, shearling or fur?</p></article><article class="guide-card"><h3><a href="/en/guides/leather-jacket-fit-guide/">Find your fit</a></h3><p>Check comfort and layering.</p></article><article class="guide-card"><h3><a href="/en/guides/budapest-outerwear-shopping/">Plan a Budapest fitting</a></h3><p>Prepare for your store visit.</p></article><article class="guide-card"><h3><a href="/en/guides/custom-leather-jacket-order/">Explore custom orders</a></h3><p>Prepare your idea and questions.</p></article></div><div class="actions"><a class="btn btn-primary" href="/en/collections/">Explore the collections</a><a class="btn btn-ghost" href="/en/visit/">Directions &amp; opening hours</a></div></div></section>
<section class="guide-search-section"><div class="wrap"><div id="guide-search"></div></div></section>
<section><div class="wrap"><div class="guide-list">{guides.map(g=><article class="guide-card"><span class="tag mono">{g.topic}</span><h2><a href={`/en/guides/${g.slug}/`}>{g.title}</a></h2><p>{g.description}</p><p class="guide-meta">{g.readingMinutes} min read</p><a href={`/en/guides/${g.slug}/`}>Read guide →</a></article>)}</div></div></section>
<Fragment slot="scripts"><script is:inline>
window.addEventListener('load', () => {
  const startSearch = () => {
    const style = document.createElement('link');
    style.rel = 'stylesheet'; style.href = '/pagefind/pagefind-ui.css';
    document.head.append(style);
    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => new PagefindUI({element:'#guide-search',showSubResults:true,showImages:false});
    document.body.append(script);
  };
  if ('requestIdleCallback' in window) requestIdleCallback(startSearch);
  else setTimeout(startSearch, 0);
});
</script></Fragment>
</BaseLayout>
